#!/usr/bin/env python3
"""
Anvil WebUI / Tauri-WebKit2GTK Console Shell
Provides a hardware-accelerated 60fps CSS/WebGL console UI on Steam Deck (1280x800)
with direct controller input streaming, cartridge management, and game launching.
"""
import os
import sys
import json
import time
import shutil
import signal
import subprocess
import threading
import urllib.parse
from http.server import HTTPServer, SimpleHTTPRequestHandler

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("WebKit2", "4.1")
from gi.repository import Gtk, Gdk, GLib, WebKit2

ANVIL_ROOT = os.environ.get("ANVIL_ROOT", "/usr/local/share/anvil")
WEBUI_DIR = os.path.join(ANVIL_ROOT, "src", "webui")
LIBRARY_SCRIPT = os.path.join(ANVIL_ROOT, "src", "daemon", "anvil_library.py")
GAME_SESSION_SCRIPT = os.path.join(ANVIL_ROOT, "scripts", "anvil-game-session")
NAV_WATCH_SCRIPT = os.path.join(ANVIL_ROOT, "scripts", "anvil-controller-nav-watch")
CARTRIDGE_TOOL = "/usr/local/bin/anvil-cartridge-tool"

# Global state
CACHED_GAMES = []
CACHED_DRIVES = []
GAME_RUNNING = False
GAME_PROC = None
WINDOW_INSTANCE = None
WEBVIEW_INSTANCE = None
PORT = 19480


def get_disk_usage(path, require_mount=False):
    try:
        if os.path.exists(path):
            if require_mount and not os.path.ismount(path):
                return {"total_gb": 0, "used_gb": 0, "free_gb": 0, "percent": 0, "mounted": False}
            total, used, free = shutil.disk_usage(path)
            return {
                "total_gb": round(total / (1024**3), 1),
                "used_gb": round(used / (1024**3), 1),
                "free_gb": round(free / (1024**3), 1),
                "percent": round((used / total) * 100) if total > 0 else 0,
                "mounted": True
            }
    except Exception:
        pass
    return {"total_gb": 0, "used_gb": 0, "free_gb": 0, "percent": 0, "mounted": False}


def refresh_library():
    global CACHED_GAMES, CACHED_DRIVES
    try:
        res = subprocess.check_output(
            ["python3", LIBRARY_SCRIPT, "--scan"],
            stderr=subprocess.DEVNULL,
            timeout=15
        )
        games = json.loads(res.decode("utf-8", errors="ignore"))
        CACHED_GAMES = [g for g in games if not g.get("dummy")]
    except Exception as e:
        print(f"[anvil-webui] Library scan error: {e}", file=sys.stderr)

    sd = get_disk_usage("/mnt/sdcard")
    ssd = get_disk_usage("/")
    usb = get_disk_usage("/mnt/usb", require_mount=True)
    CACHED_DRIVES = [
        {
            "id": "sdcard",
            "name": "MicroSD Cartridge",
            "path": "/mnt/sdcard",
            "role": "PRIMARY CARTRIDGE",
            "badge": "SD",
            "game_count": len([g for g in CACHED_GAMES if "/mnt/sdcard" in g.get("path", "")]),
            **sd
        },
        {
            "id": "nvme",
            "name": "Internal NVMe SSD",
            "path": "/dev/nvme0n1p2",
            "role": "SYSTEM OS (PROTECTED)",
            "badge": "NVMe",
            "game_count": 0,
            **ssd
        },
        {
            "id": "usb",
            "name": "External USB Slot",
            "path": "/mnt/usb",
            "role": "HOT-SWAP CARTRIDGE",
            "badge": "USB",
            "game_count": len([g for g in CACHED_GAMES if "/mnt/usb" in g.get("path", "")]),
            **usb
        }
    ]


class AnvilAPIHandler(SimpleHTTPRequestHandler):
    def log_message(self, format, *args):
        pass  # keep console clean

    def send_json(self, data, status=200):
        body = json.dumps(data).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        query = urllib.parse.parse_qs(parsed.query)

        if path == "/api/state":
            bat_pct = 100
            bat_charging = False
            try:
                for b in ("BAT1", "BAT0", "battery"):
                    cap_file = f"/sys/class/power_supply/{b}/capacity"
                    stat_file = f"/sys/class/power_supply/{b}/status"
                    if os.path.exists(cap_file):
                        with open(cap_file) as f:
                            bat_pct = int(f.read().strip())
                        if os.path.exists(stat_file):
                            with open(stat_file) as sf:
                                bat_charging = "Charging" in sf.read()
                        break
            except Exception:
                pass

            self.send_json({
                "games": CACHED_GAMES,
                "drives": CACHED_DRIVES,
                "game_running": GAME_RUNNING,
                "battery": {
                    "percent": bat_pct,
                    "charging": bat_charging
                },
                "system": {
                    "model": "Valve Steam Deck (Jupiter)",
                    "os": "Anvil Console OS v3.5 (Xbox Series X Shell)",
                    "resolution": "1280 x 800 (16:10 Native)",
                    "refresh_rate": "60 Hz",
                    "runner": "GE-Proton11-9",
                    "controller": "Steam Deck Built-in Xbox Bridge (Zero-Drift 4000dz)"
                }
            })
            return

        if path == "/api/rescan":
            refresh_library()
            self.send_json({"ok": True, "games": CACHED_GAMES, "drives": CACHED_DRIVES})
            return

        if path == "/api/input":
            act = query.get("a", [""])[0]
            if act:
                eval_js(f"window.onAnvilInput && window.onAnvilInput({json.dumps(act)}, 'steamdeck', 'Steam Deck');")
            self.send_json({"ok": True, "action": act})
            return

        if path == "/art":
            file_path = query.get("p", [""])[0]
            if file_path and os.path.isfile(file_path):
                ext = os.path.splitext(file_path)[1].lower()
                mime = {
                    ".jpg": "image/jpeg",
                    ".jpeg": "image/jpeg",
                    ".png": "image/png",
                    ".webp": "image/webp",
                    ".svg": "image/svg+xml"
                }.get(ext, "application/octet-stream")
                try:
                    with open(file_path, "rb") as f:
                        content = f.read()
                    self.send_response(200)
                    self.send_header("Content-Type", mime)
                    self.send_header("Content-Length", str(len(content)))
                    self.send_header("Cache-Control", "public, max-age=3600")
                    self.end_headers()
                    self.wfile.write(content)
                    return
                except Exception:
                    pass
            self.send_response(404)
            self.end_headers()
            return

        # Serve static files from WEBUI_DIR
        if path == "/" or path == "":
            path = "/index.html"
        full_path = os.path.realpath(os.path.join(WEBUI_DIR, path.lstrip("/")))
        if full_path.startswith(os.path.realpath(WEBUI_DIR)) and os.path.isfile(full_path):
            ext = os.path.splitext(full_path)[1].lower()
            mime = {
                ".html": "text/html; charset=utf-8",
                ".css": "text/css; charset=utf-8",
                ".js": "application/javascript; charset=utf-8",
                ".png": "image/png",
                ".jpg": "image/jpeg",
                ".svg": "image/svg+xml"
            }.get(ext, "application/octet-stream")
            with open(full_path, "rb") as f:
                content = f.read()
            self.send_response(200)
            self.send_header("Content-Type", mime)
            self.send_header("Content-Length", str(len(content)))
            self.end_headers()
            self.wfile.write(content)
            return

        self.send_response(404)
        self.end_headers()

    def do_POST(self):
        parsed = urllib.parse.urlparse(self.path)
        length = int(self.headers.get("Content-Length", 0))
        body = json.loads(self.rfile.read(length).decode("utf-8")) if length > 0 else {}

        if parsed.path == "/api/launch":
            game_name = body.get("name", "")
            launch_cmd = body.get("launch_command", "")
            game_id = body.get("forgeworks_app_id", "")
            if launch_cmd:
                threading.Thread(
                    target=launch_game_session,
                    args=(launch_cmd, game_name, game_id),
                    daemon=True
                ).start()
                self.send_json({"ok": True, "status": "launching"})
                return
            self.send_json({"ok": False, "error": "Missing launch_command"}, 400)
            return

        if parsed.path == "/api/kill":
            kill_game_session()
            self.send_json({"ok": True})
            return

        if parsed.path == "/api/resume":
            global OVERLAY_OPEN
            OVERLAY_OPEN = False
            subprocess.Popen(["hyprctl", "dispatch", "focuscurrentorlast"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            self.send_json({"ok": True})
            return

        if parsed.path == "/api/cartridge/init":
            target_path = body.get("path", "/mnt/sdcard")
            label = body.get("label", "Anvil Cartridge")
            try:
                subprocess.run([CARTRIDGE_TOOL, "init", target_path, label], check=True)
                refresh_library()
                self.send_json({
                    "ok": True,
                    "message": f"Initialized {target_path} as '{label}' (Games/ + cartridge.meta created)",
                    "drives": CACHED_DRIVES,
                    "games": CACHED_GAMES
                })
            except Exception as e:
                self.send_json({"ok": False, "error": str(e)}, 500)
            return

        if parsed.path == "/api/power":
            action = body.get("action", "")
            if action == "sleep":
                subprocess.Popen(["systemctl", "suspend"])
            elif action == "restart":
                subprocess.Popen(["systemctl", "reboot"])
            elif action == "shutdown":
                subprocess.Popen(["systemctl", "poweroff"])
            elif action == "desktop":
                subprocess.Popen(["sh", "-c", "command -v anvil-switch-desktop >/dev/null 2>&1 && anvil-switch-desktop || hyprctl dispatch exit"])
            self.send_json({"ok": True})
            return

        self.send_json({"ok": False}, 404)


OVERLAY_OPEN = False


def eval_js(script):
    if WEBVIEW_INSTANCE:
        GLib.idle_add(lambda: WEBVIEW_INSTANCE.evaluate_javascript(script, -1, None, None, None, None, None) and False)


def launch_game_session(cmd, name, game_id):
    global GAME_RUNNING, GAME_PROC, OVERLAY_OPEN
    if GAME_RUNNING:
        return
    GAME_RUNNING = True
    OVERLAY_OPEN = False
    eval_js(f"window.onAnvilGameState && window.onAnvilGameState(true, {json.dumps(name)});")

    try:
        full_cmd = [
            GAME_SESSION_SCRIPT,
            "run",
            "--name", name or "",
            "--game-id", game_id or "",
            "--",
            cmd
        ]
        GAME_PROC = subprocess.Popen(full_cmd)
        GAME_PROC.wait()
    except Exception as e:
        print(f"[anvil-webui] Game launch error: {e}", file=sys.stderr)
    finally:
        GAME_RUNNING = False
        OVERLAY_OPEN = False
        GAME_PROC = None
        eval_js("window.onAnvilGameState && window.onAnvilGameState(false, '');")
        subprocess.Popen(["hyprctl", "dispatch", "focuswindow", "title:^(Anvil Console OS)$"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def kill_game_session():
    global GAME_RUNNING, GAME_PROC, OVERLAY_OPEN
    OVERLAY_OPEN = False
    try:
        subprocess.run([GAME_SESSION_SCRIPT, "stop"], timeout=5)
    except Exception:
        pass
    if GAME_PROC:
        try:
            GAME_PROC.terminate()
        except Exception:
            pass
    GAME_RUNNING = False
    eval_js("window.onAnvilGameState && window.onAnvilGameState(false, '');")
    subprocess.Popen(["hyprctl", "dispatch", "focuswindow", "title:^(Anvil Console OS)$"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def controller_watch_thread():
    global OVERLAY_OPEN
    while True:
        try:
            proc = subprocess.Popen(
                ["python3", NAV_WATCH_SCRIPT],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                bufsize=1
            )
            for line in proc.stdout:
                line = line.strip()
                if not line.startswith("NAV "):
                    continue
                parts = line.split(" ", 3)
                action = parts[1] if len(parts) > 1 else ""
                family = parts[2] if len(parts) > 2 else "steamdeck"
                name = parts[3] if len(parts) > 3 else "Steam Deck"
                if not action:
                    continue
                if GAME_RUNNING:
                    if action == "guide":
                        OVERLAY_OPEN = not OVERLAY_OPEN
                        if OVERLAY_OPEN:
                            subprocess.Popen(["hyprctl", "dispatch", "focuswindow", "title:^(Anvil Console OS)$"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        else:
                            subprocess.Popen(["hyprctl", "dispatch", "focuscurrentorlast"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        eval_js(f"window.onAnvilInput && window.onAnvilInput('guide', {json.dumps(family)}, {json.dumps(name)});")
                    elif OVERLAY_OPEN:
                        eval_js(f"window.onAnvilInput && window.onAnvilInput({json.dumps(action)}, {json.dumps(family)}, {json.dumps(name)});")
                    continue
                # When no game is running, ignore 'guide' so STEAM button never opens overlay on Home
                if action == "guide":
                    continue
                eval_js(f"window.onAnvilInput && window.onAnvilInput({json.dumps(action)}, {json.dumps(family)}, {json.dumps(name)});")
        except Exception as e:
            print(f"[anvil-webui] Controller watch error: {e}", file=sys.stderr)
        time.sleep(1.0)


def start_http_server():
    global PORT
    for p in range(19480, 19520):
        try:
            server = HTTPServer(("127.0.0.1", p), AnvilAPIHandler)
            PORT = p
            threading.Thread(target=server.serve_forever, daemon=True).start()
            return
        except OSError:
            continue


def main():
    os.environ.setdefault("GDK_BACKEND", "wayland,x11")
    os.environ.setdefault("WEBKIT_DISABLE_COMPOSITING_MODE", "0")

    refresh_library()
    start_http_server()
    threading.Thread(target=controller_watch_thread, daemon=True).start()

    Gtk.init(sys.argv)

    win = Gtk.Window(title="Anvil Console OS")
    win.set_default_size(1280, 800)
    win.set_decorated(False)
    win.fullscreen()

    # Dark background so startup never flashes white
    rgba = Gdk.RGBA(0.03, 0.04, 0.06, 1.0)
    win.override_background_color(Gtk.StateFlags.NORMAL, rgba)

    settings = WebKit2.Settings()
    settings.set_enable_webgl(True)
    settings.set_enable_accelerated_2d_canvas(True)
    settings.set_enable_smooth_scrolling(True)
    settings.set_enable_developer_extras(False)
    settings.set_hardware_acceleration_policy(WebKit2.HardwareAccelerationPolicy.ALWAYS)

    webview = WebKit2.WebView.new_with_settings(settings)
    webview.set_background_color(rgba)
    webview.load_uri(f"http://127.0.0.1:{PORT}/")

    global WINDOW_INSTANCE, WEBVIEW_INSTANCE
    WINDOW_INSTANCE = win
    WEBVIEW_INSTANCE = webview

    win.add(webview)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()

    Gtk.main()


if __name__ == "__main__":
    main()
