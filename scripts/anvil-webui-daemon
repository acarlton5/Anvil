#!/usr/bin/env python3
"""
Anvil WebUI / Tauri-WebKit2GTK Console Shell v4.5
Provides a hardware-accelerated 60fps CSS/WebGL console UI on Steam Deck (1280x800)
with direct controller input streaming, STEAM (Left Guide) & Three-Dot QAM (Right Sidebar),
full PipeWire Audio & Mic control, Display Brightness, System Update Manager,
Network Inspector, and instant Workspace 2 game launching.
"""
import os
import re
import sys
import json
import time
import socket
import glob
import shutil
import signal
import subprocess
import threading
import urllib.parse
from http.server import ThreadingHTTPServer, SimpleHTTPRequestHandler

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("WebKit2", "4.1")
from gi.repository import Gtk, Gdk, GdkPixbuf, GLib, WebKit2
import hashlib

ANVIL_ROOT = os.environ.get("ANVIL_ROOT", "/usr/local/share/anvil")
WEBUI_DIR = os.path.join(ANVIL_ROOT, "src", "webui")
LIBRARY_SCRIPT = os.path.join(ANVIL_ROOT, "src", "daemon", "anvil_library.py")
GAME_SESSION_SCRIPT = os.path.join(ANVIL_ROOT, "scripts", "anvil-game-session")
AUDIO_SCRIPT = os.path.join(ANVIL_ROOT, "scripts", "anvil-audio-control")
CARTRIDGE_TOOL = "/usr/local/bin/anvil-cartridge-tool"
ART_CACHE_DIR = "/dev/shm/anvil-art"
ART_BYTES_CACHE = {}

# Global state
CACHED_GAMES = []
CACHED_DRIVES = []
GAME_RUNNING = False
GAME_PROC = None
OVERLAY_OPEN = False
OVERLAY_MODE = ""  # "guide" (left STEAM sidebar) or "qam" (right Three-Dot sidebar)
WINDOW_INSTANCE = None
WEBVIEW_INSTANCE = None
PORT = 19480

_last_vol_time = 0.0
_vol_lock = threading.Lock()


def hypr_eval(lua_code):
    """Execute Lua code in the active Hyprland compositor."""
    try:
        subprocess.run(
            ["hyprctl", "eval", lua_code],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=1.5
        )
    except Exception:
        pass


def setup_hyprland_game_rules():
    """Register a live Hyprland window.open hook so games immediately open fullscreen on Workspace 2."""
    lua_hook = (
        'if not _G._anvil_ws_hook_installed then '
        '_G._anvil_ws_hook_installed = true; '
        'hl.on("window.open", function(w) '
        'if w.class == "anvil-webui-daemon" then '
        'hl.dispatch(hl.dsp.window.move({ workspace = 1, window = w })); '
        'hl.dispatch(hl.dsp.window.fullscreen({ mode = "fullscreen", action = "set", window = w })) '
        'else '
        'hl.dispatch(hl.dsp.window.move({ workspace = 2, window = w })); '
        'hl.dispatch(hl.dsp.window.fullscreen({ mode = "fullscreen", action = "set", window = w })); '
        'hl.dispatch(hl.dsp.focus({ workspace = 2 })); '
        'hl.dispatch(hl.dsp.focus({ window = w })) '
        'end '
        'end) '
        'end'
    )
    hypr_eval(lua_hook)


def show_anvil_window():
    """Switch immediately to Workspace 1 where Anvil Console OS is fullscreen."""
    hypr_eval(
        'for _, w in ipairs(hl.get_windows()) do '
        'if w.class == "anvil-webui-daemon" then '
        'hl.dispatch(hl.dsp.window.move({ workspace = 1, window = w })); '
        'hl.dispatch(hl.dsp.window.fullscreen({ mode = "fullscreen", action = "set", window = w })); '
        'hl.dispatch(hl.dsp.focus({ workspace = 1 })); '
        'hl.dispatch(hl.dsp.focus({ window = w })) '
        'end '
        'end'
    )


def show_game_window():
    """Ensure active game window is on Workspace 2 fullscreen and switch focus to Workspace 2."""
    hypr_eval(
        'for _, w in ipairs(hl.get_windows()) do '
        'if w.class ~= "anvil-webui-daemon" then '
        'hl.dispatch(hl.dsp.window.move({ workspace = 2, window = w })); '
        'hl.dispatch(hl.dsp.window.fullscreen({ mode = "fullscreen", action = "set", window = w })); '
        'hl.dispatch(hl.dsp.focus({ workspace = 2 })); '
        'hl.dispatch(hl.dsp.focus({ window = w })) '
        'end '
        'end'
    )


def has_game_window():
    """Check if any non-Anvil window is mapped in Hyprland."""
    try:
        out = subprocess.check_output(["hyprctl", "clients", "-j"], stderr=subprocess.DEVNULL, timeout=1.0)
        clients = json.loads(out.decode("utf-8", errors="ignore"))
        for c in clients:
            if c.get("class") != "anvil-webui-daemon" and c.get("mapped"):
                return True
    except Exception:
        pass
    return False


def get_full_audio_state():
    """Return detailed audio state including sinks, sources, volume, and mic."""
    pct, muted = get_volume_state()
    mic_pct, mic_muted = 80, False
    sink_name = "Steam Deck Speakers (acp5x)"
    source_name = "Internal Microphone"
    sinks = []
    try:
        if os.path.exists(AUDIO_SCRIPT):
            raw = subprocess.check_output(["python3", AUDIO_SCRIPT, "status"], stderr=subprocess.DEVNULL, timeout=1.5)
            data = json.loads(raw.decode("utf-8", errors="ignore"))
            sinks = data.get("sinks", [])
            cs = data.get("current_sink")
            if cs:
                sink_name = cs.get("name") or sink_name
                pct = cs.get("volume", pct)
                muted = bool(cs.get("muted", muted))
            csrc = data.get("current_source")
            if csrc:
                source_name = csrc.get("name") or source_name
                mic_pct = csrc.get("volume", mic_pct)
                mic_muted = bool(csrc.get("muted", mic_muted))
    except Exception:
        pass
    return {
        "percent": pct,
        "muted": muted,
        "sink_name": sink_name,
        "sinks": sinks,
        "mic_percent": mic_pct,
        "mic_muted": mic_muted,
        "source_name": source_name
    }


def get_volume_state():
    """Return (percent_int, muted_bool) from PipeWire wpctl."""
    try:
        out = subprocess.check_output(
            ["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"],
            stderr=subprocess.DEVNULL,
            timeout=1.5
        ).decode("utf-8", errors="ignore")
        m = re.search(r"Volume:\s*([0-9.]+)", out)
        pct = int(round(float(m.group(1)) * 100)) if m else 75
        muted = "MUTED" in out.upper()
        return max(0, min(100, pct)), muted
    except Exception:
        return 75, False


def handle_volume_action(direction="status"):
    """Adjust PipeWire volume/mic/sink, trigger WebUI Volume OSD, and show in-game Hyprland OSD if game is active."""
    global _last_vol_time
    now = time.monotonic()
    with _vol_lock:
        if direction in ("up", "down", "mute", "mic-up", "mic-down", "mic-mute", "cycle-sink"):
            if now - _last_vol_time < 0.06:
                return get_volume_state()
            _last_vol_time = now
            try:
                if direction == "up":
                    subprocess.run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "0"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=1.0)
                    subprocess.run(["wpctl", "set-volume", "-l", "1.0", "@DEFAULT_AUDIO_SINK@", "5%+"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=1.0)
                elif direction == "down":
                    subprocess.run(["wpctl", "set-volume", "-l", "1.0", "@DEFAULT_AUDIO_SINK@", "5%-"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=1.0)
                elif direction == "mute":
                    subprocess.run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=1.0)
                elif direction == "mic-up":
                    subprocess.run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", "0"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=1.0)
                    subprocess.run(["wpctl", "set-volume", "-l", "1.0", "@DEFAULT_AUDIO_SOURCE@", "5%+"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=1.0)
                elif direction == "mic-down":
                    subprocess.run(["wpctl", "set-volume", "-l", "1.0", "@DEFAULT_AUDIO_SOURCE@", "5%-"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=1.0)
                elif direction == "mic-mute":
                    subprocess.run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", "toggle"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=1.0)
                elif direction == "cycle-sink" and os.path.exists(AUDIO_SCRIPT):
                    subprocess.run(["python3", AUDIO_SCRIPT, "cycle-sink"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=1.5)
            except Exception:
                pass

    pct, muted = get_volume_state()
    if direction in ("up", "down", "mute"):
        eval_js(f"window.onAnvilVolumeOSD && window.onAnvilVolumeOSD({pct}, {'true' if muted else 'false'});")
        if GAME_RUNNING and not OVERLAY_OPEN:
            filled = max(0, min(10, round(pct / 10)))
            bar = ("█" * filled) + ("░" * (10 - filled))
            label = f"VOLUME  {bar}  {'MUTED' if muted else f'{pct}%'}"
            try:
                subprocess.Popen(
                    ["sh", "-c", f"hyprctl dismissnotify >/dev/null 2>&1; hyprctl notify -1 1800 'rgb(22c55e)' {json.dumps(label)} >/dev/null 2>&1"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL
                )
            except Exception:
                pass
    return pct, muted


def get_brightness_state():
    """Return current screen brightness percentage (10..100)."""
    try:
        out = subprocess.check_output(["brightnessctl", "-m"], stderr=subprocess.DEVNULL, timeout=1.0).decode("utf-8", errors="ignore")
        parts = out.strip().split(",")
        if len(parts) >= 4:
            pct_str = parts[3].replace("%", "").strip()
            if pct_str.isdigit():
                return max(5, min(100, int(pct_str)))
    except Exception:
        pass
    return 85


def handle_brightness_action(direction="status"):
    if direction == "up":
        subprocess.run(["brightnessctl", "set", "10%+"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif direction == "down":
        subprocess.run(["brightnessctl", "-n", "10%", "set", "10%-"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    pct = get_brightness_state()
    if direction in ("up", "down"):
        eval_js(f"window.onAnvilBrightnessOSD && window.onAnvilBrightnessOSD({pct});")
        if GAME_RUNNING and not OVERLAY_OPEN:
            filled = max(0, min(10, round(pct / 10)))
            bar = ("█" * filled) + ("░" * (10 - filled))
            label = f"BRIGHTNESS  {bar}  {pct}%"
            try:
                subprocess.Popen(
                    ["sh", "-c", f"hyprctl dismissnotify >/dev/null 2>&1; hyprctl notify -1 1800 'rgb(38bdf8)' {json.dumps(label)} >/dev/null 2>&1"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL
                )
            except Exception:
                pass
    return pct


def get_network_info():
    """Return active network info (SSID, IP, Tailscale IP, hostname)."""
    hostname = socket.gethostname()
    lan_ip = "127.0.0.1"
    tailscale_ip = ""
    ssid = "Wi-Fi 6 Connected"
    try:
        out = subprocess.check_output(["ip", "-4", "-o", "addr", "show"], stderr=subprocess.DEVNULL, timeout=1.0).decode("utf-8", errors="ignore")
        for line in out.splitlines():
            parts = line.split()
            if len(parts) >= 4:
                iface = parts[1]
                ip = parts[3].split("/")[0]
                if iface == "lo":
                    continue
                if iface.startswith("tailscale") or ip.startswith("100."):
                    tailscale_ip = ip
                elif lan_ip == "127.0.0.1":
                    lan_ip = ip
    except Exception:
        pass
    try:
        iw = subprocess.check_output(["iwgetid", "-r"], stderr=subprocess.DEVNULL, timeout=1.0).decode("utf-8", errors="ignore").strip()
        if iw:
            ssid = iw
    except Exception:
        pass
    return {
        "connected": True,
        "ssid": ssid,
        "lan_ip": lan_ip,
        "tailscale_ip": tailscale_ip or "100.101.162.75",
        "hostname": hostname
    }


def get_hypeshell_sock():
    uid = os.getuid()
    socks = glob.glob(f"/run/user/{uid}/HYPESHELL-*.sock")
    return socks[0] if socks else None


def call_hypeshell_rpc(method, params=None, timeout=3.0):
    sock_path = get_hypeshell_sock()
    if not sock_path or not os.path.exists(sock_path):
        return None
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect(sock_path)
        s.recv(4096)  # discard greeting
        req = {"jsonrpc": "2.0", "method": method, "params": params or {}, "id": 1}
        s.sendall(json.dumps(req).encode("utf-8") + b"\n")
        raw = b""
        while True:
            chunk = s.recv(4096)
            if not chunk:
                break
            raw += chunk
            if b"\n" in chunk:
                break
        s.close()
        res = json.loads(raw.decode("utf-8"))
        return res.get("result")
    except Exception:
        return None


def get_update_info():
    """Return Anvil OS version, kernel, and real HypeShell update status."""
    kernel = "Linux 6.x"
    try:
        kernel = subprocess.check_output(["uname", "-sr"], stderr=subprocess.DEVNULL, timeout=1.0).decode("utf-8", errors="ignore").strip()
    except Exception:
        pass

    state = call_hypeshell_rpc("sysupdate.getState")
    packages = []
    count = 0
    phase = "idle"
    progress = 0
    status_step = ""
    current_item = ""

    if state:
        phase = state.get("phase", "idle")
        packages = state.get("packages") or []
        count = state.get("count", len(packages))
        progress = state.get("progress", 0)
        status_step = state.get("statusStep", "")
        current_item = state.get("currentItem", "")

    return {
        "current_version": "Anvil Console OS 5.0 (SteamOS 3.6 Deck Edition)",
        "build_id": "2026.10.21-live",
        "channel": "Stable (Steam Deck Jupiter)",
        "kernel": kernel,
        "up_to_date": (count == 0 and phase == "idle"),
        "pending_count": count,
        "packages": packages,
        "phase": phase,
        "progress": progress,
        "status_step": status_step,
        "current_item": current_item,
        "last_checked": time.strftime("%I:%M %p"),
        "changelog": [
            "HypeShell Real-Time System Updates Bridge with Zero-Terminal Background Execution",
            "Hardware-Accelerated WebKit2GTK Console UI with Clean Hidden Mouse Cursor",
            "SteamOS 3.6 + Xbox Series X Hybrid Console UI with Widescreen Hero Stage",
            "Full PipeWire Audio & Microphone Settings + Top-Center Volume/Brightness OSD",
            "STEAM Button (Left Guide Blade) & Three-Dot ••• (Right Quick Settings Drawer)",
            "Player 1 Exclusive Xbox 360 Controller Bridge with 4000 Deadzone Lock"
        ]
    }


def get_disk_usage(path, require_mount=False):
    try:
        if os.path.exists(path):
            if require_mount and not os.path.ismount(path):
                return {"total_gb": 0, "used_gb": 0, "free_gb": 0, "percent": 0, "mounted": False}
            total, used, free = shutil.disk_usage(path)
            return {
                "total_gb": round(total / (1024**3), 1),
                "used_gb": round(used / (1024**3), 1),
                "free_gb": round(free / (1024**3), 1),
                "percent": round((used / total) * 100) if total > 0 else 0,
                "mounted": True
            }
    except Exception:
        pass
    return {"total_gb": 0, "used_gb": 0, "free_gb": 0, "percent": 0, "mounted": False}


def get_optimized_art_bytes(file_path):
    """Return RAM-cached & resolution-optimized image bytes so WebKit2GTK never lags on MicroSD reads."""
    if not file_path or not os.path.isfile(file_path):
        return None, None

    cached = ART_BYTES_CACHE.get(file_path)
    if cached:
        return cached

    os.makedirs(ART_CACHE_DIR, exist_ok=True)
    base = os.path.basename(file_path).lower()
    ext = os.path.splitext(file_path)[1].lower()
    key = hashlib.md5(file_path.encode("utf-8")).hexdigest()[:16]

    try:
        if "hero" in base:
            shm_file = os.path.join(ART_CACHE_DIR, f"{key}_hero.jpg")
            if not os.path.isfile(shm_file):
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(file_path, 1280, -1, True)
                pb.savev(shm_file, "jpeg", ["quality"], ["85"])
            with open(shm_file, "rb") as f:
                data = f.read()
            ART_BYTES_CACHE[file_path] = (data, "image/jpeg")
            return data, "image/jpeg"

        elif "grid" in base or "600x900" in base or "cover" in base or "poster" in base:
            shm_file = os.path.join(ART_CACHE_DIR, f"{key}_grid.jpg")
            if not os.path.isfile(shm_file):
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(file_path, 340, -1, True)
                pb.savev(shm_file, "jpeg", ["quality"], ["86"])
            with open(shm_file, "rb") as f:
                data = f.read()
            ART_BYTES_CACHE[file_path] = (data, "image/jpeg")
            return data, "image/jpeg"

        elif "logo" in base:
            shm_file = os.path.join(ART_CACHE_DIR, f"{key}_logo.png")
            if not os.path.isfile(shm_file):
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(file_path, 520, -1, True)
                pb.savev(shm_file, "png", [], [])
            with open(shm_file, "rb") as f:
                data = f.read()
            ART_BYTES_CACHE[file_path] = (data, "image/png")
            return data, "image/png"
    except Exception:
        pass

    try:
        mime = {
            ".jpg": "image/jpeg",
            ".jpeg": "image/jpeg",
            ".png": "image/png",
            ".webp": "image/webp",
            ".svg": "image/svg+xml"
        }.get(ext, "application/octet-stream")
        with open(file_path, "rb") as f:
            data = f.read()
        ART_BYTES_CACHE[file_path] = (data, mime)
        return data, mime
    except Exception:
        return None, None


def prewarm_art_cache():
    """Pre-warm all 48 games' hero, grid, and logo images into /dev/shm/anvil-art and RAM."""
    for g in list(CACHED_GAMES):
        for k in ("hero", "grid", "logo"):
            p = g.get(k)
            if p:
                get_optimized_art_bytes(p)


def refresh_library():
    global CACHED_GAMES, CACHED_DRIVES
    try:
        res = subprocess.check_output(
            ["python3", LIBRARY_SCRIPT, "--scan"],
            stderr=subprocess.DEVNULL,
            timeout=15
        )
        games = json.loads(res.decode("utf-8", errors="ignore"))
        CACHED_GAMES = [g for g in games if not g.get("dummy")]
        threading.Thread(target=prewarm_art_cache, daemon=True).start()
    except Exception as e:
        print(f"[anvil-webui] Library scan error: {e}", file=sys.stderr)

    sd = get_disk_usage("/mnt/sdcard")
    ssd = get_disk_usage("/")
    usb = get_disk_usage("/mnt/usb", require_mount=True)
    CACHED_DRIVES = [
        {
            "id": "sdcard",
            "name": "MicroSD Cartridge",
            "path": "/mnt/sdcard",
            "role": "PRIMARY CARTRIDGE",
            "badge": "SD",
            "game_count": len([g for g in CACHED_GAMES if "/mnt/sdcard" in g.get("path", "")]),
            **sd
        },
        {
            "id": "nvme",
            "name": "Internal NVMe SSD",
            "path": "/dev/nvme0n1p2",
            "role": "SYSTEM OS (PROTECTED)",
            "badge": "NVMe",
            "game_count": 0,
            **ssd
        },
        {
            "id": "usb",
            "name": "External USB Slot",
            "path": "/mnt/usb",
            "role": "HOT-SWAP CARTRIDGE",
            "badge": "USB",
            "game_count": len([g for g in CACHED_GAMES if "/mnt/usb" in g.get("path", "")]),
            **usb
        }
    ]


class AnvilAPIHandler(SimpleHTTPRequestHandler):
    def log_message(self, format, *args):
        pass

    def send_json(self, data, status=200):
        body = json.dumps(data).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        query = urllib.parse.parse_qs(parsed.query)

        if path == "/api/state":
            bat_pct = 100
            bat_charging = False
            try:
                for b in ("BAT1", "BAT0", "battery"):
                    cap_file = f"/sys/class/power_supply/{b}/capacity"
                    stat_file = f"/sys/class/power_supply/{b}/status"
                    if os.path.exists(cap_file):
                        with open(cap_file) as f:
                            bat_pct = int(f.read().strip())
                        if os.path.exists(stat_file):
                            with open(stat_file) as sf:
                                bat_charging = "Charging" in sf.read()
                        break
            except Exception:
                pass

            audio_info = get_full_audio_state()
            bright_pct = get_brightness_state()
            net_info = get_network_info()
            upd_info = get_update_info()

            self.send_json({
                "games": CACHED_GAMES,
                "drives": CACHED_DRIVES,
                "game_running": GAME_RUNNING,
                "overlay_open": OVERLAY_OPEN,
                "overlay_mode": OVERLAY_MODE,
                "volume": audio_info,
                "brightness": {"percent": bright_pct},
                "network": net_info,
                "update": upd_info,
                "battery": {
                    "percent": bat_pct,
                    "charging": bat_charging
                },
                "system": {
                    "model": "Valve Steam Deck (Jupiter)",
                    "os": "Anvil Console OS 5.0 (SteamOS 3.6 Deck Edition)",
                    "resolution": "1280 x 800 (16:10 Native)",
                    "refresh_rate": "60 Hz VRR",
                    "runner": "GE-Proton11-9",
                    "controller": "Steam Deck Built-in Xbox Bridge (Player 1 Locked)"
                }
            })
            return

        if path == "/api/volume":
            direction = query.get("dir", ["status"])[0]
            handle_volume_action(direction)
            audio_info = get_full_audio_state()
            self.send_json({"ok": True, **audio_info})
            return

        if path == "/api/brightness":
            direction = query.get("dir", ["status"])[0]
            pct = handle_brightness_action(direction)
            self.send_json({"ok": True, "percent": pct})
            return

        if path == "/api/update":
            refresh_library()
            self.send_json({"ok": True, "update": get_update_info(), "games_count": len(CACHED_GAMES)})
            return

        if path == "/api/rescan":
            refresh_library()
            self.send_json({"ok": True, "games": CACHED_GAMES, "drives": CACHED_DRIVES})
            return

        if path == "/api/input":
            act = query.get("a", [""])[0]
            if act:
                dispatch_controller_action(act, "steamdeck", "Steam Deck")
            self.send_json({"ok": True, "action": act})
            return

        if path == "/art":
            file_path = query.get("p", [""])[0]
            content, mime = get_optimized_art_bytes(file_path)
            if content and mime:
                try:
                    self.send_response(200)
                    self.send_header("Content-Type", mime)
                    self.send_header("Content-Length", str(len(content)))
                    self.send_header("Cache-Control", "public, max-age=86400, immutable")
                    self.end_headers()
                    self.wfile.write(content)
                    return
                except Exception:
                    pass
            self.send_response(404)
            self.end_headers()
            return

        if path == "/" or path == "":
            path = "/index.html"
        full_path = os.path.realpath(os.path.join(WEBUI_DIR, path.lstrip("/")))
        if full_path.startswith(os.path.realpath(WEBUI_DIR)) and os.path.isfile(full_path):
            ext = os.path.splitext(full_path)[1].lower()
            mime = {
                ".html": "text/html; charset=utf-8",
                ".css": "text/css; charset=utf-8",
                ".js": "application/javascript; charset=utf-8",
                ".png": "image/png",
                ".jpg": "image/jpeg",
                ".svg": "image/svg+xml"
            }.get(ext, "application/octet-stream")
            with open(full_path, "rb") as f:
                content = f.read()
            self.send_response(200)
            self.send_header("Content-Type", mime)
            self.send_header("Content-Length", str(len(content)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(content)
            return

        self.send_response(404)
        self.end_headers()

    def do_POST(self):
        parsed = urllib.parse.urlparse(self.path)
        length = int(self.headers.get("Content-Length", 0))
        body = json.loads(self.rfile.read(length).decode("utf-8")) if length > 0 else {}

        if parsed.path == "/api/launch":
            game_name = body.get("name", "")
            launch_cmd = body.get("launch_command", "")
            game_id = body.get("forgeworks_app_id", "")
            if launch_cmd:
                threading.Thread(
                    target=launch_game_session,
                    args=(launch_cmd, game_name, game_id),
                    daemon=True
                ).start()
                self.send_json({"ok": True, "status": "launching"})
                return
            self.send_json({"ok": False, "error": "Missing launch_command"}, 400)
            return

        if parsed.path == "/api/kill":
            kill_game_session()
            self.send_json({"ok": True})
            return

        if parsed.path == "/api/resume":
            global OVERLAY_OPEN, OVERLAY_MODE
            OVERLAY_OPEN = False
            OVERLAY_MODE = ""
            eval_js("window.onAnvilOverlayState && window.onAnvilOverlayState(false, '');")
            show_game_window()
            self.send_json({"ok": True})
            return

        if parsed.path == "/api/cartridge/init":
            target_path = body.get("path", "/mnt/sdcard")
            label = body.get("label", "Anvil Cartridge")
            try:
                subprocess.run([CARTRIDGE_TOOL, "init", target_path, label], check=True)
                refresh_library()
                self.send_json({
                    "ok": True,
                    "message": f"Initialized {target_path} as '{label}' (Games/ + cartridge.meta created)",
                    "drives": CACHED_DRIVES,
                    "games": CACHED_GAMES
                })
            except Exception as e:
                self.send_json({"ok": False, "error": str(e)}, 500)
            return

        if parsed.path == "/api/power":
            action = body.get("action", "")
            if action == "sleep":
                subprocess.Popen(["systemctl", "suspend"])
            elif action == "restart":
                subprocess.Popen(["systemctl", "reboot"])
            elif action == "shutdown":
                subprocess.Popen(["systemctl", "poweroff"])
            elif action == "desktop":
                subprocess.Popen(["sh", "-c", "command -v anvil-switch-desktop >/dev/null 2>&1 && anvil-switch-desktop || hyprctl eval 'hl.dispatch(hl.dsp.exit())'"])
            self.send_json({"ok": True})
            return

        if parsed.path == "/api/update/check":
            call_hypeshell_rpc("sysupdate.refresh")
            self.send_json({"ok": True, "update": get_update_info()})
            return

        if parsed.path == "/api/update/apply":
            call_hypeshell_rpc("sysupdate.upgrade")
            self.send_json({"ok": True, "update": get_update_info()})
            return

        self.send_json({"ok": False}, 404)


def eval_js(script):
    if WEBVIEW_INSTANCE:
        GLib.idle_add(lambda: WEBVIEW_INSTANCE.evaluate_javascript(script, -1, None, None, None, None, None) and False)


def game_window_watcher():
    """While a game is starting up, immediately move its window to Workspace 2 fullscreen as soon as it maps."""
    setup_hyprland_game_rules()
    switched_once = False
    while GAME_RUNNING:
        if not OVERLAY_OPEN:
            if has_game_window():
                show_game_window()
                if not switched_once:
                    switched_once = True
                    eval_js("window.onAnvilGameWindowReady && window.onAnvilGameWindowReady();")
                time.sleep(1.0)
                continue
        time.sleep(0.2)


def launch_game_session(cmd, name, game_id):
    global GAME_RUNNING, GAME_PROC, OVERLAY_OPEN, OVERLAY_MODE
    if GAME_RUNNING:
        return
    GAME_RUNNING = True
    OVERLAY_OPEN = False
    OVERLAY_MODE = ""
    eval_js(f"window.onAnvilGameState && window.onAnvilGameState(true, {json.dumps(name)});")

    threading.Thread(target=game_window_watcher, daemon=True).start()

    try:
        full_cmd = [
            GAME_SESSION_SCRIPT,
            "run",
            "--name", name or "",
            "--game-id", game_id or "",
            "--",
            cmd
        ]
        GAME_PROC = subprocess.Popen(full_cmd)
        GAME_PROC.wait()
    except Exception as e:
        print(f"[anvil-webui] Game launch error: {e}", file=sys.stderr)
    finally:
        GAME_RUNNING = False
        OVERLAY_OPEN = False
        OVERLAY_MODE = ""
        GAME_PROC = None
        eval_js("window.onAnvilGameState && window.onAnvilGameState(false, '');")
        show_anvil_window()


def kill_game_session():
    global GAME_RUNNING, GAME_PROC, OVERLAY_OPEN, OVERLAY_MODE
    OVERLAY_OPEN = False
    OVERLAY_MODE = ""
    try:
        subprocess.run([GAME_SESSION_SCRIPT, "stop"], timeout=5)
    except Exception:
        pass
    if GAME_PROC:
        try:
            GAME_PROC.terminate()
        except Exception:
            pass
    GAME_RUNNING = False
    eval_js("window.onAnvilGameState && window.onAnvilGameState(false, '');")
    show_anvil_window()


def dispatch_controller_action(action, family="xbox", name="Xbox Series X Controller"):
    global OVERLAY_OPEN, OVERLAY_MODE
    if not action:
        return

    if action == "vol_up":
        handle_volume_action("up")
        return
    if action == "vol_down":
        handle_volume_action("down")
        return
    if action == "vol_mute":
        handle_volume_action("mute")
        return

    if GAME_RUNNING:
        if action in ("guide", "qam"):
            if OVERLAY_OPEN and OVERLAY_MODE == action:
                OVERLAY_OPEN = False
                OVERLAY_MODE = ""
                eval_js("window.onAnvilOverlayState && window.onAnvilOverlayState(false, '');")
                show_game_window()
            else:
                OVERLAY_OPEN = True
                OVERLAY_MODE = action
                eval_js(f"window.onAnvilOverlayState && window.onAnvilOverlayState(true, {json.dumps(action)});")
                show_anvil_window()
            return

        if OVERLAY_OPEN:
            eval_js(f"window.onAnvilInput && window.onAnvilInput({json.dumps(action)}, {json.dumps(family)}, {json.dumps(name)});")
        return

    eval_js(f"window.onAnvilInput && window.onAnvilInput({json.dumps(action)}, {json.dumps(family)}, {json.dumps(name)});")


def controller_watch_thread():
    import evdev
    from evdev import ecodes
    import select as _select

    KEY_TO_ACTION = {
        294: "qam",       # Three-Dot (...) Quick Access Button
        148: "qam",
        149: "qam",
        217: "qam",
        304: "south",     # A
        305: "east",      # B
        307: "west",      # X (physical X on Steam Deck / xpad)
        308: "north",     # Y (physical Y on Steam Deck / xpad)
        310: "lb",        # LB
        311: "rb",        # RB
        312: "lt",        # LT digital
        313: "rt",        # RT digital
        314: "select",    # View / Select
        315: "start",     # Menu / Start
        316: "guide",     # STEAM / Guide
        172: "guide",
        544: "up",
        545: "down",
        546: "left",
        547: "right",
        113: "vol_mute",  # Hardware Mute
        114: "vol_down",  # Hardware Volume Down
        115: "vol_up",    # Hardware Volume Up
    }

    axis_active = {}
    last_fire = {}

    while True:
        devs = []
        try:
            for p in sorted(evdev.list_devices()):
                try:
                    d = evdev.InputDevice(p)
                    nm = (d.name or "").lower()
                    caps = d.capabilities().get(ecodes.EV_KEY, [])
                    is_pad = (
                        any(k in nm for k in ("x-box", "xbox", "steam deck", "gamepad", "controller"))
                        and "motion" not in nm
                        and "mouse" not in nm
                        and "keyboard" not in nm
                    )
                    is_vol_hw = (114 in caps or 115 in caps) and "valve software" not in nm
                    if is_pad or is_vol_hw:
                        devs.append(d)
                except Exception:
                    pass

            if not devs:
                time.sleep(0.5)
                continue

            fd_map = {d.fd: d for d in devs}
            while True:
                r, _, _ = _select.select(list(fd_map.keys()), [], [], 1.0)
                for fd in r:
                    d = fd_map[fd]
                    for ev in d.read():
                        act = None
                        if ev.type == ecodes.EV_KEY:
                            if ev.code in (114, 115) and ev.value in (1, 2):
                                act = KEY_TO_ACTION.get(ev.code)
                            elif ev.value == 1:
                                act = KEY_TO_ACTION.get(ev.code)
                        elif ev.type == ecodes.EV_ABS:
                            c = ev.code
                            v = ev.value
                            if c == ecodes.ABS_HAT0X:
                                if v < 0:
                                    act = "left"
                                elif v > 0:
                                    act = "right"
                                else:
                                    axis_active.pop("hatx", None)
                                if act:
                                    if axis_active.get("hatx") == act:
                                        act = None
                                    else:
                                        axis_active["hatx"] = act
                            elif c == ecodes.ABS_HAT0Y:
                                if v < 0:
                                    act = "up"
                                elif v > 0:
                                    act = "down"
                                else:
                                    axis_active.pop("haty", None)
                                if act:
                                    if axis_active.get("haty") == act:
                                        act = None
                                    else:
                                        axis_active["haty"] = act
                            elif c == ecodes.ABS_X:
                                if v < -16500:
                                    cand = "left"
                                elif v > 16500:
                                    cand = "right"
                                elif -10000 < v < 10000:
                                    axis_active.pop("lx", None)
                                    cand = None
                                else:
                                    cand = None
                                if cand and axis_active.get("lx") != cand:
                                    axis_active["lx"] = cand
                                    act = cand
                            elif c == ecodes.ABS_Y:
                                if v < -16500:
                                    cand = "up"
                                elif v > 16500:
                                    cand = "down"
                                elif -10000 < v < 10000:
                                    axis_active.pop("ly", None)
                                    cand = None
                                else:
                                    cand = None
                                if cand and axis_active.get("ly") != cand:
                                    axis_active["ly"] = cand
                                    act = cand
                            elif c == ecodes.ABS_Z:
                                if v > 140 and not axis_active.get("lt"):
                                    axis_active["lt"] = True
                                    act = "lt"
                                elif v < 60:
                                    axis_active["lt"] = False
                            elif c == ecodes.ABS_RZ:
                                if v > 140 and not axis_active.get("rt"):
                                    axis_active["rt"] = True
                                    act = "rt"
                                elif v < 60:
                                    axis_active["rt"] = False

                        if act:
                            now = time.monotonic()
                            cooldown = 0.07 if act in ("vol_up", "vol_down") else 0.11
                            if now - last_fire.get(act, 0) >= cooldown:
                                last_fire[act] = now
                                dispatch_controller_action(act, "xbox", d.name or "Xbox Controller")
        except Exception as e:
            print(f"[anvil-webui] Controller watch reconnect: {e}", file=sys.stderr)
        finally:
            for d in devs:
                try:
                    d.close()
                except Exception:
                    pass
        time.sleep(0.5)


def start_http_server():
    global PORT
    for p in range(19480, 19520):
        try:
            ThreadingHTTPServer.allow_reuse_address = True
            server = ThreadingHTTPServer(("127.0.0.1", p), AnvilAPIHandler)
            PORT = p
            threading.Thread(target=server.serve_forever, daemon=True).start()
            return
        except OSError:
            continue


def main():
    os.environ.setdefault("GDK_BACKEND", "wayland,x11")
    os.environ.setdefault("WEBKIT_DISABLE_COMPOSITING_MODE", "0")

    setup_hyprland_game_rules()
    refresh_library()
    start_http_server()
    threading.Thread(target=controller_watch_thread, daemon=True).start()

    Gtk.init(sys.argv)

    win = Gtk.Window(title="Anvil Console OS")
    win.set_default_size(1280, 800)
    win.set_decorated(False)
    win.fullscreen()

    rgba = Gdk.RGBA(0.03, 0.04, 0.06, 1.0)
    win.override_background_color(Gtk.StateFlags.NORMAL, rgba)

    settings = WebKit2.Settings()
    settings.set_enable_webgl(True)
    settings.set_enable_accelerated_2d_canvas(True)
    settings.set_enable_smooth_scrolling(True)
    settings.set_enable_developer_extras(False)
    settings.set_hardware_acceleration_policy(WebKit2.HardwareAccelerationPolicy.ALWAYS)

    webview = WebKit2.WebView.new_with_settings(settings)
    webview.set_background_color(rgba)
    webview.load_uri(f"http://127.0.0.1:{PORT}/")

    global WINDOW_INSTANCE, WEBVIEW_INSTANCE
    WINDOW_INSTANCE = win
    WEBVIEW_INSTANCE = webview

    win.add(webview)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()

    Gtk.main()


if __name__ == "__main__":
    main()
