#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 3 ]]; then
    echo "usage: anvil-proton-run GAME_NAME PROTON_TARGET EXE_PATH [LAUNCH_OPTIONS...]" >&2
    exit 64
fi

game_name="$1"
proton_target="$2"
exe_path="$3"
shift 3
raw_options=("$@")

steam_dir="${STEAM_DIR:-$HOME/.local/share/Steam}"
prefix_dir="${ANVIL_PREFIX_DIR:-$HOME/.local/share/anvil/prefixes/$game_name}"

mkdir -p "$prefix_dir"

# Ensure runtime environment for display
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [[ -z "${DISPLAY:-}" ]]; then
    for disp in :0 :1; do
        if [[ -e "/tmp/.X11-unix/X${disp#*:}" ]]; then
            export DISPLAY="$disp"
            break
        fi
    done
    export DISPLAY="${DISPLAY:-:0}"
fi

if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
    for wl in wayland-1 wayland-0; do
        if [[ -S "$XDG_RUNTIME_DIR/$wl" ]]; then
            export WAYLAND_DISPLAY="$wl"
            break
        fi
    done
    export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
fi

# Disable Xalia accessibility helper to avoid headless crash
export PROTON_USE_XALIA="${PROTON_USE_XALIA:-0}"

# Route controller strictly through our virtual Microsoft X-Box 360 pad (045e:028e) as Player 1
export PROTON_NO_STEAMINPUT="1"
export PROTON_DISABLE_HIDRAW="1"
export WINE_DISABLE_HIDRAW="1"
export SDL_GAMECONTROLLER_IGNORE_DEVICES="0x28de/0x1205,0x28de/0x1142"
export SDL_GAMECONTROLLER_ALLOW_STEAM_VIRTUAL_GAMEPAD="1"
export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS="1"
unset SDL_GAMECONTROLLERCONFIG || true
unset SDL_GAMEPADCONFIG || true

# Ensure winebus registry flags in prefix: Enable SDL=1 and DisableHidraw=1
# so Wine always binds 'Microsoft X-Box 360 pad' (evdev/SDL) as XInput Slot 0 (Player 1)
if [[ -f "$prefix_dir/pfx/system.reg" ]]; then
    python3 -c "
import re
path = '''$prefix_dir/pfx/system.reg'''
try:
    with open(path, 'r', encoding='utf-8', errors='ignore') as f:
        text = f.read()
    orig = text
    text = re.sub(r'\"DisableHidraw\"=dword:[0-9a-fA-F]+\r?\n?', '', text)
    text = re.sub(r'\"Enable SDL\"=dword:[0-9a-fA-F]+\r?\n?', '', text)
    pattern = re.compile(r'(\[System.*Services.*winebus\])')
    if pattern.search(text):
        text = pattern.sub(r'\1\n\"Enable SDL\"=dword:00000001\n\"DisableHidraw\"=dword:00000001', text, count=1)
    if text != orig:
        with open(path, 'w', encoding='utf-8') as f:
            f.write(text)
except Exception:
    pass
" 2>/dev/null || true
fi

# Search order for Proton binary: check requested target first if provided
proton_bin=""

if [[ -n "${proton_target:-}" && "$proton_target" != "default" && "$proton_target" != "Proton Experimental" ]]; then
    for candidate in \
        "$steam_dir/steamapps/common/$proton_target/proton" \
        "$steam_dir/steamapps/common/Proton $proton_target/proton" \
        "$steam_dir/compatibilitytools.d/$proton_target/proton" \
        "/opt/proton/$proton_target/proton" \
        "/opt/proton/$proton_target/files/bin/proton" \
        "/usr/share/steam/compatibilitytools.d/$proton_target/proton"; do
        if [[ -x "$candidate" ]]; then
            proton_bin="$candidate"
            break
        fi
    done

    if [[ -z "$proton_bin" ]]; then
        for candidate in $(find "$steam_dir/steamapps/common" "$steam_dir/compatibilitytools.d" /opt/proton -maxdepth 2 -iname "*${proton_target}*" -name proton 2>/dev/null); do
            if [[ -x "$candidate" ]]; then
                proton_bin="$candidate"
                break
            fi
        done
    fi
fi

if [[ -z "$proton_bin" ]]; then
    for candidate in \
        $(find /opt/proton -maxdepth 2 -type f -name proton 2>/dev/null | sort -V | tail -n 1) \
        $(find "$steam_dir/compatibilitytools.d" -maxdepth 2 -type f -name proton 2>/dev/null | sort -V | tail -n 1) \
        "$steam_dir/steamapps/common/Proton - Experimental/proton" \
        "$steam_dir/steamapps/common/Proton 9.0 (Beta)/proton" \
        "$steam_dir/steamapps/common/Proton 8.0/proton" \
        /usr/share/steam/compatibilitytools.d/*/proton; do
        if [[ -x "$candidate" ]]; then
            proton_bin="$candidate"
            break
        fi
    done
fi

if [[ -z "$proton_bin" || ! -f "$proton_bin" ]]; then
    echo "ERROR: Proton binary not found. Checked /opt/proton and Steam compatibility tools." >&2
    exit 1
fi

export STEAM_COMPAT_DATA_PATH="$prefix_dir"
export STEAM_COMPAT_CLIENT_INSTALL_PATH="${steam_dir}"

# Separate environment variable assignments from exe arguments
env_vars=()
game_args=()

for opt in "${raw_options[@]}"; do
    eval "tokens=($opt)" 2>/dev/null || tokens=("$opt")
    for tok in "${tokens[@]}"; do
        if [[ "$tok" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
            env_vars+=("$tok")
        elif [[ -n "$tok" && "$tok" != "%command%" ]]; then
            game_args+=("$tok")
        fi
    done
done

for ev in "${env_vars[@]}"; do
    export "$ev"
done

# Always change working directory to game executable directory (Cartridge preservation)
game_dir="$(dirname "$exe_path")"
if [[ -d "$game_dir" ]]; then
    cd "$game_dir"
fi

exec "$proton_bin" run "$exe_path" "${game_args[@]}"
