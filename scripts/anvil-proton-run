#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 3 ]]; then
    echo "usage: anvil-proton-run GAME_NAME PROTON_TARGET EXE_PATH [LAUNCH_OPTIONS...]" >&2
    exit 64
fi

game_name="$1"
proton_target="$2"
exe_path="$3"
shift 3
raw_options=("$@")

steam_dir="${STEAM_DIR:-$HOME/.local/share/Steam}"
prefix_dir="${ANVIL_PREFIX_DIR:-$HOME/.local/share/anvil/prefixes/$game_name}"

mkdir -p "$prefix_dir"

# Ensure runtime environment for display
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [[ -z "${DISPLAY:-}" ]]; then
    for disp in :0 :1; do
        if [[ -e "/tmp/.X11-unix/X${disp#*:}" ]]; then
            export DISPLAY="$disp"
            break
        fi
    done
    export DISPLAY="${DISPLAY:-:0}"
fi

if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
    for wl in wayland-1 wayland-0; do
        if [[ -S "$XDG_RUNTIME_DIR/$wl" ]]; then
            export WAYLAND_DISPLAY="$wl"
            break
        fi
    done
    export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
fi

# Disable Xalia accessibility helper to avoid headless crash
export PROTON_USE_XALIA="${PROTON_USE_XALIA:-0}"

# Disable raw hidraw access and route controller through SDL2 backend
export PROTON_DISABLE_HIDRAW="1"
export WINE_DISABLE_HIDRAW="1"
export PROTON_NO_STEAMINPUT="1"
unset SDL_GAMECONTROLLER_IGNORE_DEVICES || true
unset SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT || true

# Route controller through SDL2 with accurate Steam Deck mappings
deck_guid="0300f617de2800000512000000036800"
deck_guid_alt="03000000de2800000512000011010000"
deck_guid_std="03000000de2800000512000000036800"
deck_guid_x="0300000028de00001205000001100000"

deck_map="${deck_guid},Steam Deck Controller,a:b3,b:b4,x:b5,y:b6,back:b11,start:b12,guide:b13,leftstick:b14,rightstick:b15,leftshoulder:b7,rightshoulder:b8,lefttrigger:b9,righttrigger:b10,dpup:h0.1,dpdown:h0.4,dpleft:h0.8,dpright:h0.2,leftx:a0,lefty:a1,rightx:a2,righty:a3,platform:Linux,"
deck_map_alt="${deck_guid_alt},Steam Deck Controller,a:b3,b:b4,x:b5,y:b6,back:b11,start:b12,guide:b13,leftstick:b14,rightstick:b15,leftshoulder:b7,rightshoulder:b8,lefttrigger:b9,righttrigger:b10,dpup:h0.1,dpdown:h0.4,dpleft:h0.8,dpright:h0.2,leftx:a0,lefty:a1,rightx:a2,righty:a3,platform:Linux,"
deck_map_std="${deck_guid_std},Steam Deck Controller,a:b3,b:b4,x:b5,y:b6,back:b11,start:b12,guide:b13,leftstick:b14,rightstick:b15,leftshoulder:b7,rightshoulder:b8,lefttrigger:b9,righttrigger:b10,dpup:h0.1,dpdown:h0.4,dpleft:h0.8,dpright:h0.2,leftx:a0,lefty:a1,rightx:a2,righty:a3,platform:Linux,"
deck_map_x="${deck_guid_x},Steam Deck Controller,a:b3,b:b4,x:b5,y:b6,back:b11,start:b12,guide:b13,leftstick:b14,rightstick:b15,leftshoulder:b7,rightshoulder:b8,lefttrigger:b9,righttrigger:b10,dpup:h0.1,dpdown:h0.4,dpleft:h0.8,dpright:h0.2,leftx:a0,lefty:a1,rightx:a2,righty:a3,platform:Linux,"

all_deck_maps="${deck_map}${deck_map_alt}${deck_map_std}${deck_map_x}"
if [[ -n "${SDL_GAMECONTROLLERCONFIG:-}" ]]; then
    export SDL_GAMECONTROLLERCONFIG="${all_deck_maps}${SDL_GAMECONTROLLERCONFIG}"
else
    export SDL_GAMECONTROLLERCONFIG="${all_deck_maps}"
fi
export SDL_GAMEPADCONFIG="$SDL_GAMECONTROLLERCONFIG"
export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1

# Ensure winebus registry flags in prefix: Enable SDL=0 (enables SDL in winebus) and DisableHidraw=1
if [[ -f "$prefix_dir/pfx/system.reg" ]]; then
    python3 -c "
path = '$prefix_dir/pfx/system.reg'
try:
    with open(path, 'r', encoding='utf-8', errors='ignore') as f:
        text = f.read()
    target = '[System\\\\\\\\ControlSet001\\\\\\\\Services\\\\\\\\winebus]'
    if target in text:
        if '\"DisableHidraw\"' not in text:
            text = text.replace(target, target + '\n\"DisableHidraw\"=dword:00000001', 1)
        if '\"Enable SDL\"' not in text:
            text = text.replace(target, target + '\n\"Enable SDL\"=dword:00000000', 1)
        elif '\"Enable SDL\"=dword:00000001' in text:
            text = text.replace('\"Enable SDL\"=dword:00000001', '\"Enable SDL\"=dword:00000000')
        with open(path, 'w', encoding='utf-8') as f:
            f.write(text)
except Exception:
    pass
" 2>/dev/null || true
fi

# Search order for Proton binary:
# 1. System GE-Proton / custom Proton installed in /opt/proton
# 2. Steam compatibilitytools.d
# 3. Steam official Proton
proton_bin=""
for candidate in \
    $(find /opt/proton -maxdepth 2 -type f -name proton 2>/dev/null | sort -V | tail -n 1) \
    $(find "$steam_dir/compatibilitytools.d" -maxdepth 2 -type f -name proton 2>/dev/null | sort -V | tail -n 1) \
    "$steam_dir/steamapps/common/Proton - Experimental/proton" \
    "$steam_dir/steamapps/common/Proton 9.0 (Beta)/proton" \
    "$steam_dir/steamapps/common/Proton 8.0/proton" \
    /usr/share/steam/compatibilitytools.d/*/proton; do
    if [[ -x "$candidate" ]]; then
        proton_bin="$candidate"
        break
    fi
done

if [[ -z "$proton_bin" || ! -f "$proton_bin" ]]; then
    echo "ERROR: Proton binary not found. Checked /opt/proton and Steam compatibility tools." >&2
    exit 1
fi

export STEAM_COMPAT_DATA_PATH="$prefix_dir"
export STEAM_COMPAT_CLIENT_INSTALL_PATH="${steam_dir}"

# Separate environment variable assignments (like WINEDLLOVERRIDES=...) from exe arguments (like -dx11)
env_vars=()
game_args=()

for opt in "${raw_options[@]}"; do
    eval "tokens=($opt)" 2>/dev/null || tokens=("$opt")
    for tok in "${tokens[@]}"; do
        if [[ "$tok" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
            env_vars+=("$tok")
        elif [[ -n "$tok" && "$tok" != "%command%" ]]; then
            game_args+=("$tok")
        fi
    done
done

# Apply env overrides
for ev in "${env_vars[@]}"; do
    export "$ev"
done

exec "$proton_bin" run "$exe_path" "${game_args[@]}"
