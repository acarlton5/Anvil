#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
plugin_dir="$(dirname -- "$script_dir")"
repo_root="$(cd -- "$plugin_dir/../../.." && pwd)"

script_repo="$(cd -- "$script_dir/.." && pwd)"

anvil_root="${1:-${ANVIL_ROOT:-}}"
if [ -z "$anvil_root" ] || [ ! -f "$anvil_root/src/ui/AnvilDaemon.qml" ]; then
    for candidate in \
        "$anvil_root" \
        "$script_repo" \
        "$repo_root" \
        "$HOME/.config/HypeShell/plugins/hypeAnvil" \
        "$HOME/Projects/Projects/Anvil" \
        "$HOME/DevBox/Projects/Anvil" \
        "$HOME/Projects/Anvil" \
        "/opt/anvil" \
        "/usr/local/share/anvil"; do
        if [ -n "$candidate" ] && [ -f "$candidate/src/ui/AnvilDaemon.qml" ]; then
            anvil_root="$candidate"
            break
        fi
    done
fi

if [ -z "$anvil_root" ] || [ ! -f "$anvil_root/src/ui/AnvilDaemon.qml" ]; then
    echo "Anvil root not found. Pass a path or set ANVIL_ROOT." >&2
    exit 64
fi

if ! command -v sudo >/dev/null 2>&1; then
    echo "sudo is required to install the system session files." >&2
    exit 1
fi

stage_dir="$(mktemp -d)"
staged_paths=()
STAGED_RESULT=""

stage_file() {
    local src="$1"
    local rel="$2"
    local dest="$stage_dir/$rel"
    mkdir -p "$(dirname -- "$dest")"
    cp "$src" "$dest"
    staged_paths+=("$dest")
    STAGED_RESULT="$dest"
}

stage_tree() {
    local src="$1"
    local rel="$2"
    local dest="$stage_dir/$rel"
    mkdir -p "$(dirname -- "$dest")"
    cp -R "$src" "$dest"
    staged_paths+=("$dest")
    STAGED_RESULT="$dest"
}

cleanup_stage() {
    find "$stage_dir" -depth -type f -exec unlink {} \; 2>/dev/null || true
    find "$stage_dir" -depth -type d -empty -exec rmdir {} \; 2>/dev/null || true
}
trap cleanup_stage EXIT

stage_file "$anvil_root/session/anvil-session.sh" session/anvil-session.sh
session_src="$STAGED_RESULT"
stage_file "$anvil_root/scripts/anvil-proton-run" scripts/anvil-proton-run
runner_src="$STAGED_RESULT"
stage_file "$anvil_root/scripts/anvil-game-session" scripts/anvil-game-session
game_session_src="$STAGED_RESULT"
stage_file "$anvil_root/scripts/anvil-achievement-claim" scripts/anvil-achievement-claim
achievement_claim_src="$STAGED_RESULT"
stage_file "$anvil_root/scripts/anvil-achievement-status" scripts/anvil-achievement-status
achievement_status_src="$STAGED_RESULT"
stage_file "$anvil_root/scripts/anvil-input-inspect" scripts/anvil-input-inspect
input_inspect_src="$STAGED_RESULT"
stage_file "$anvil_root/scripts/anvil-controller-overlay-watch" scripts/anvil-controller-overlay-watch
controller_overlay_watch_src="$STAGED_RESULT"
stage_file "$anvil_root/scripts/anvil-controller-nav-watch" scripts/anvil-controller-nav-watch
controller_nav_watch_src="$STAGED_RESULT"
stage_file "$anvil_root/scripts/anvil-overlay-toggle" scripts/anvil-overlay-toggle
overlay_toggle_src="$STAGED_RESULT"
stage_file "$anvil_root/scripts/anvil-switch-desktop" scripts/anvil-switch-desktop
switch_desktop_src="$STAGED_RESULT"
stage_file "$anvil_root/scripts/anvil-switch-gaming" scripts/anvil-switch-gaming
switch_gaming_src="$STAGED_RESULT"
stage_file "$anvil_root/scripts/anvil-quickaccess-toggle" scripts/anvil-quickaccess-toggle
quickaccess_toggle_src="$STAGED_RESULT"
stage_file "$anvil_root/scripts/anvil-keyboard-toggle" scripts/anvil-keyboard-toggle
keyboard_toggle_src="$STAGED_RESULT"
stage_file "$anvil_root/scripts/anvil-audio-control" scripts/anvil-audio-control
audio_control_src="$STAGED_RESULT"
stage_file "$anvil_root/session/hyprland-anvil.lua" session/hyprland-anvil.lua
hypr_src="$STAGED_RESULT"
stage_file "$anvil_root/src/ui/AnvilDaemon.qml" src/ui/AnvilDaemon.qml
daemon_qml_src="$STAGED_RESULT"
stage_file "$anvil_root/src/ui/AnvilLauncher.qml" src/ui/AnvilLauncher.qml
launcher_qml_src="$STAGED_RESULT"
stage_file "$anvil_root/src/ui/AnvilOverlay.qml" src/ui/AnvilOverlay.qml
overlay_qml_src="$STAGED_RESULT"
stage_file "$anvil_root/src/ui/AnvilTheme.qml" src/ui/AnvilTheme.qml
theme_qml_src="$STAGED_RESULT"
stage_file "$anvil_root/src/ui/qmldir" src/ui/qmldir
qmldir_src="$STAGED_RESULT"
stage_file "$anvil_root/src/ui/AnvilVolumeOSD.qml" src/ui/AnvilVolumeOSD.qml
volume_osd_qml_src="$STAGED_RESULT"
stage_file "$anvil_root/src/ui/AnvilQuickAccess.qml" src/ui/AnvilQuickAccess.qml
quickaccess_qml_src="$STAGED_RESULT"
stage_file "$anvil_root/src/ui/AnvilKeyboard.qml" src/ui/AnvilKeyboard.qml
keyboard_qml_src="$STAGED_RESULT"
stage_file "$anvil_root/assets/anvil-focus-flame.png" assets/anvil-focus-flame.png
focus_flame_src="$STAGED_RESULT"
stage_tree "$anvil_root/assets/controllercons" assets/controllercons
controllercons_src="$STAGED_RESULT"
stage_file "$anvil_root/config/sdl-gamecontrollerdb.txt" config/sdl-gamecontrollerdb.txt
sdl_controller_db_src="$STAGED_RESULT"
stage_file "$anvil_root/config/controller-devices.db" config/controller-devices.db
controller_devices_src="$STAGED_RESULT"
stage_tree "$anvil_root/config/input-maps" config/input-maps
input_maps_src="$STAGED_RESULT"
stage_tree "$anvil_root/config/input-actions" config/input-actions
input_actions_src="$STAGED_RESULT"
stage_tree "$anvil_root/config/controller-layouts" config/controller-layouts
controller_layouts_src="$STAGED_RESULT"
stage_tree "$anvil_root/config/achievements" config/achievements
achievements_src="$STAGED_RESULT"
stage_file "$anvil_root/src/daemon/anvil-library-bridge" src/daemon/anvil-library-bridge
anvil_library_bridge_src="$STAGED_RESULT"
stage_file "$anvil_root/src/daemon/anvil_library.py" src/daemon/anvil_library.py
anvil_library_src="$STAGED_RESULT"

sudo install -D -m 755 "$session_src" /usr/local/bin/anvil-session
sudo install -D -m 755 "$runner_src" /usr/local/bin/anvil-proton-run
sudo install -D -m 755 "$runner_src" /usr/local/share/anvil/scripts/anvil-proton-run
sudo install -D -m 755 "$game_session_src" /usr/local/bin/anvil-game-session
sudo install -D -m 755 "$achievement_claim_src" /usr/local/bin/anvil-achievement-claim
sudo install -D -m 755 "$achievement_status_src" /usr/local/bin/anvil-achievement-status
sudo install -D -m 755 "$input_inspect_src" /usr/local/bin/anvil-input-inspect
sudo install -D -m 755 "$controller_overlay_watch_src" /usr/local/bin/anvil-controller-overlay-watch
sudo install -D -m 755 "$controller_nav_watch_src" /usr/local/bin/anvil-controller-nav-watch
sudo install -D -m 755 "$overlay_toggle_src" /usr/local/bin/anvil-overlay-toggle
sudo install -D -m 755 "$switch_desktop_src" /usr/local/bin/anvil-switch-desktop
sudo install -D -m 755 "$switch_gaming_src" /usr/local/bin/anvil-switch-gaming
sudo install -D -m 755 "$quickaccess_toggle_src" /usr/local/bin/anvil-quickaccess-toggle
sudo install -D -m 755 "$keyboard_toggle_src" /usr/local/bin/anvil-keyboard-toggle
sudo install -D -m 755 "$audio_control_src" /usr/local/bin/anvil-audio-control
sudo install -D -m 755 "$session_src" /usr/local/share/anvil/session/anvil-session.sh
sudo install -D -m 755 "$game_session_src" /usr/local/share/anvil/scripts/anvil-game-session
sudo install -D -m 755 "$achievement_claim_src" /usr/local/share/anvil/scripts/anvil-achievement-claim
sudo install -D -m 755 "$achievement_status_src" /usr/local/share/anvil/scripts/anvil-achievement-status
sudo install -D -m 755 "$input_inspect_src" /usr/local/share/anvil/scripts/anvil-input-inspect
sudo install -D -m 755 "$controller_overlay_watch_src" /usr/local/share/anvil/scripts/anvil-controller-overlay-watch
sudo install -D -m 755 "$controller_nav_watch_src" /usr/local/share/anvil/scripts/anvil-controller-nav-watch
sudo install -D -m 755 "$overlay_toggle_src" /usr/local/share/anvil/scripts/anvil-overlay-toggle
sudo install -D -m 755 "$switch_desktop_src" /usr/local/share/anvil/scripts/anvil-switch-desktop
sudo install -D -m 755 "$switch_gaming_src" /usr/local/share/anvil/scripts/anvil-switch-gaming
sudo install -D -m 755 "$quickaccess_toggle_src" /usr/local/share/anvil/scripts/anvil-quickaccess-toggle
sudo install -D -m 755 "$keyboard_toggle_src" /usr/local/share/anvil/scripts/anvil-keyboard-toggle
sudo install -D -m 755 "$audio_control_src" /usr/local/share/anvil/scripts/anvil-audio-control
sudo install -D -m 644 "$hypr_src" /usr/local/share/anvil/session/hyprland-anvil.lua
sudo install -D -m 644 "$daemon_qml_src" /usr/local/share/anvil/src/ui/AnvilDaemon.qml
sudo install -D -m 644 "$launcher_qml_src" /usr/local/share/anvil/src/ui/AnvilLauncher.qml
sudo install -D -m 644 "$overlay_qml_src" /usr/local/share/anvil/src/ui/AnvilOverlay.qml
sudo install -D -m 644 "$theme_qml_src" /usr/local/share/anvil/src/ui/AnvilTheme.qml
sudo install -D -m 644 "$qmldir_src" /usr/local/share/anvil/src/ui/qmldir
sudo install -D -m 644 "$volume_osd_qml_src" /usr/local/share/anvil/src/ui/AnvilVolumeOSD.qml
sudo install -D -m 644 "$quickaccess_qml_src" /usr/local/share/anvil/src/ui/AnvilQuickAccess.qml
sudo install -D -m 644 "$keyboard_qml_src" /usr/local/share/anvil/src/ui/AnvilKeyboard.qml
sudo install -D -m 644 "$focus_flame_src" /usr/local/share/anvil/assets/anvil-focus-flame.png
sudo install -d -m 755 /usr/local/share/anvil/assets/controllercons
sudo cp -R "$controllercons_src"/. /usr/local/share/anvil/assets/controllercons/
sudo chmod -R u=rwX,go=rX /usr/local/share/anvil/assets/controllercons
sudo install -D -m 644 "$sdl_controller_db_src" /usr/local/share/anvil/config/sdl-gamecontrollerdb.txt
sudo install -D -m 644 "$controller_devices_src" /usr/local/share/anvil/config/controller-devices.db
sudo install -d -m 755 /usr/local/share/anvil/config/input-maps
sudo cp -R "$input_maps_src"/. /usr/local/share/anvil/config/input-maps/
sudo chmod -R u=rwX,go=rX /usr/local/share/anvil/config/input-maps
sudo install -d -m 755 /usr/local/share/anvil/config/input-actions
sudo cp -R "$input_actions_src"/. /usr/local/share/anvil/config/input-actions/
sudo chmod -R u=rwX,go=rX /usr/local/share/anvil/config/input-actions
sudo install -d -m 755 /usr/local/share/anvil/config/controller-layouts
sudo cp -R "$controller_layouts_src"/. /usr/local/share/anvil/config/controller-layouts/
sudo chmod -R u=rwX,go=rX /usr/local/share/anvil/config/controller-layouts
sudo install -d -m 755 /usr/local/share/anvil/config/achievements
sudo cp -R "$achievements_src"/. /usr/local/share/anvil/config/achievements/
sudo chmod -R u=rwX,go=rX /usr/local/share/anvil/config/achievements
sudo install -D -m 755 "$anvil_library_bridge_src" /usr/local/share/anvil/src/daemon/anvil-library-bridge
sudo install -D -m 644 "$anvil_library_src" /usr/local/share/anvil/src/daemon/anvil_library.py

release_file="$(mktemp)"
revision=""
remote=""
if command -v git >/dev/null 2>&1 && git -C "$anvil_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    revision="$(git -C "$anvil_root" rev-parse HEAD 2>/dev/null || true)"
    remote="$(git -C "$anvil_root" config --get remote.origin.url 2>/dev/null || true)"
fi
printf '{\n  "name": "Anvil",\n  "channel": "main",\n  "revision": "%s",\n  "remote": "%s"\n}\n' "$revision" "$remote" > "$release_file"
sudo install -D -m 644 "$release_file" /usr/local/share/anvil/release.json
unlink "$release_file"

session_wrapper="$(mktemp)"
cat > "$session_wrapper" <<'WRAPPER'
#!/usr/bin/env bash
set -euo pipefail

export ANVIL_ROOT="${ANVIL_ROOT:-/usr/local/share/anvil}"
exec "$ANVIL_ROOT/session/anvil-session.sh"
WRAPPER
sudo install -D -m 755 "$session_wrapper" /usr/local/bin/anvil-session
unlink "$session_wrapper"

desktop_file="$(mktemp)"
cat > "$desktop_file" <<'DESKTOP'
[Desktop Entry]
Name=Anvil
Comment=Dedicated Wayland gaming session
Exec=anvil-session
TryExec=anvil-session
Type=Application
DesktopNames=Anvil
DESKTOP
sudo install -D -m 644 "$desktop_file" /usr/share/wayland-sessions/anvil.desktop
sudo install -D -m 644 "$focus_flame_src" /usr/share/icons/hicolor/256x256/apps/anvil.png || true
unlink "$desktop_file"

app_launcher="$(mktemp)"
cat > "$app_launcher" <<'LAUNCHER'
#!/usr/bin/env bash
set -euo pipefail

export ANVIL_ROOT="${ANVIL_ROOT:-/usr/local/share/anvil}"
if command -v qs >/dev/null 2>&1; then
    QS_BIN="qs"
elif command -v quickshell >/dev/null 2>&1; then
    QS_BIN="quickshell"
else
    QS_BIN="qs"
fi
exec "$QS_BIN" -p "$ANVIL_ROOT/src/ui/AnvilDaemon.qml" "$@"
LAUNCHER
sudo install -D -m 755 "$app_launcher" /usr/local/bin/anvil
unlink "$app_launcher"

app_desktop_file="$(mktemp)"
cat > "$app_desktop_file" <<'APPDESKTOP'
[Desktop Entry]
Name=Anvil
GenericName=Gaming Console
Comment=Launch Anvil Console Gaming Client
Exec=anvil
Icon=/usr/local/share/anvil/assets/anvil-focus-flame.png
Terminal=false
Type=Application
Categories=Game;Console;
APPDESKTOP
sudo install -D -m 644 "$app_desktop_file" /usr/share/applications/anvil.desktop
unlink "$app_desktop_file"
cat << GAMINGMODE > /usr/share/applications/anvil-gaming-mode.desktop
[Desktop Entry]
Name=Return to Gaming Mode
GenericName=Gaming Mode
Comment=Switch to dedicated Anvil Gaming Session
Exec=anvil-switch-gaming
Icon=/usr/local/share/anvil/assets/anvil-focus-flame.png
Terminal=false
Type=Application
Categories=Game;Console;
GAMINGMODE
sudo install -D -m 644 /usr/share/applications/anvil-gaming-mode.desktop /home/${SUDO_USER:-morphine}/Desktop/anvil-gaming-mode.desktop 2>/dev/null || true


for legacy_path in \
    /usr/local/share/wayland-sessions/hypeshell-gamermode.desktop \
    /usr/share/wayland-sessions/hypeshell-gamermode.desktop \
    /usr/local/bin/hypeshell-gamer-session; do
    sudo sh -c '[ ! -e "$1" ] || unlink "$1"' sh "$legacy_path"
done

# Sync user hyprland.lua if user exists
target_user="${SUDO_USER:-morphine}"
user_home="$(getent passwd "$target_user" | cut -d: -f6)"
if [ -n "$user_home" ] && [ -d "$user_home" ]; then
    mkdir -p "$user_home/.config/hypr"
    install -m 644 /usr/local/share/anvil/session/hyprland-anvil.lua "$user_home/.config/hypr/hyprland.lua"
    chown -R "$target_user:$target_user" "$user_home/.config/hypr"
fi
if command -v hyprctl >/dev/null 2>&1; then
    hyprctl reload config-only >/dev/null 2>&1 || true
fi
echo "Anvil session installed. Log out and choose Anvil from the greeter."
