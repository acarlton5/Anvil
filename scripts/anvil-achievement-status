#!/usr/bin/env python3
"""Print current Anvil achievement status as JSON for the overlay."""

from __future__ import annotations

import json
import os
import shlex
import sys
import urllib.error
import urllib.request
from pathlib import Path


def load_env_file(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.is_file():
        return values
    for raw in path.read_text(encoding="utf-8").splitlines():
        if "=" not in raw:
            continue
        key, value = raw.split("=", 1)
        values[key] = unquote_shell(value)
    return values


def unquote_shell(value: str) -> str:
    value = value.strip()
    try:
        parsed = shlex.split(value)
        if parsed:
            return parsed[0]
    except ValueError:
        pass
    return value


def load_json(path: str) -> dict:
    if not path:
        return {}
    try:
        with open(path, "r", encoding="utf-8") as handle:
            data = json.load(handle)
            return data if isinstance(data, dict) else {}
    except OSError:
        return {}
    except json.JSONDecodeError:
        return {}


def fetch_json(url: str) -> dict:
    request = urllib.request.Request(url, headers={"accept": "application/json"})
    with urllib.request.urlopen(request, timeout=3) as response:
        data = json.loads(response.read().decode("utf-8"))
        return data if isinstance(data, dict) else {}


def summarize_input_actions(path: str) -> dict[str, object]:
    actions = load_json(path)
    compatibility = actions.get("compatibility", {}) if isinstance(actions.get("compatibility", {}), dict) else {}
    return {
        "input_actions": actions.get("id") or Path(path).stem if path else "",
        "input_runtime_mode": actions.get("runtime_mode") or "default",
        "input_glyph_mode": actions.get("glyph_mode") or "auto",
        "input_can_show_correct_glyphs": bool(compatibility.get("can_show_correct_glyphs", True)),
    }


def main() -> int:
    runtime_root = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "anvil"
    session_env = load_env_file(runtime_root / "game-session" / "current.env")
    get = lambda key, default="": os.environ.get(key) or session_env.get(key) or default

    game_name = get("ANVIL_GAME_NAME", "Current game")
    game_id = get("ANVIL_GAME_ID")
    player_id = get("ANVIL_PLAYER_ID", "local-dev")
    set_id = get("ANVIL_ACHIEVEMENT_SET")
    set_file = get("ANVIL_ACHIEVEMENT_SET_FILE")
    input_actions_file = get("ANVIL_INPUT_ACTIONS_FILE")
    service_url = get("ANVIL_ACHIEVEMENTS_URL") or get("FORGEWORKS_ACHIEVEMENTS_URL") or "http://127.0.0.1:18080"

    achievement_set = load_json(set_file)
    if not achievement_set and set_id:
        service_set_id = set_id[:-5] if set_id.endswith(".json") else set_id
        try:
            achievement_set = fetch_json(f"{service_url.rstrip('/')}/v1/achievement-sets/{service_set_id}")
        except (OSError, urllib.error.URLError, json.JSONDecodeError):
            achievement_set = {}

    claims = []
    service_state = "offline"
    try:
        payload = fetch_json(f"{service_url.rstrip('/')}/v1/players/{player_id}/achievements")
        claims = payload.get("claims", []) if isinstance(payload.get("claims", []), list) else []
        service_state = "online"
    except (OSError, urllib.error.URLError, json.JSONDecodeError):
        claims = []

    set_key = achievement_set.get("id") or (set_id[:-5] if set_id.endswith(".json") else set_id)
    claimed = {
        claim.get("achievement_id")
        for claim in claims
        if claim.get("achievement_set") in {set_id, set_key}
    }
    achievements = []
    for item in achievement_set.get("achievements", []):
        achievement_id = item.get("id", "")
        achievements.append(
            {
                "id": achievement_id,
                "name": item.get("name", achievement_id),
                "description": item.get("description", ""),
                "points": item.get("points", 0),
                "claimed": achievement_id in claimed,
            }
        )

    result = {
        "game_name": game_name,
        "game_id": game_id,
        "player_id": player_id,
        "service_url": service_url,
        "service_state": service_state,
        "set": set_key,
        "set_name": achievement_set.get("name") or "Achievements",
        "claimed": len([item for item in achievements if item["claimed"]]),
        "total": len(achievements),
        "achievements": achievements,
    }
    result.update(summarize_input_actions(input_actions_file))
    print(json.dumps(result))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
