#!/usr/bin/env python3
import fcntl
import os
import select
import struct
import subprocess
import sys
import time

_lock_fd = None

def ensure_single_instance(name):
    global _lock_fd
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime_dir or not os.path.isdir(runtime_dir):
        runtime_dir = "/tmp"
    lock_file = os.path.join(runtime_dir, f"{name}_{os.getuid()}.lock")
    try:
        _lock_fd = os.open(lock_file, os.O_CREAT | os.O_RDWR, 0o600)
        fcntl.flock(_lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        os.ftruncate(_lock_fd, 0)
        os.write(_lock_fd, f"{os.getpid()}\n".encode())
    except (BlockingIOError, OSError):
        # Check if previous process is orphaned or dead
        try:
            with open(lock_file, "r") as lf:
                old_pid = int(lf.read().strip())
            if old_pid != os.getpid():
                try:
                    os.kill(old_pid, 15) # SIGTERM
                    time.sleep(0.15)
                except OSError:
                    pass
                _lock_fd = os.open(lock_file, os.O_CREAT | os.O_RDWR, 0o600)
                fcntl.flock(_lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                os.ftruncate(_lock_fd, 0)
                os.write(_lock_fd, f"{os.getpid()}\n".encode())
                return
        except Exception:
            pass
        sys.exit(0)

EV_KEY = 1
EV_ABS = 3
# Linux input_event.value is signed; D-pad left/up arrive as -1.
EVENT_STRUCT = "llHHi"
EVENT_SIZE = struct.calcsize(EVENT_STRUCT)

GUIDE_CODES = {172, 316}
QUICKACCESS_CODES = {294, 148, 149, 217}
X_CODES = {307, 308}
A_CODES = {304}

KEY_ACTIONS = {
    304: "south",
    305: "east",
    307: "north",
    308: "west",
    310: "lb",
    311: "rb",
    312: "lt",
    313: "rt",
    314: "back",
    315: "start",
    316: "guide",
    172: "guide",
    294: "quickaccess",
    544: "up",
    545: "down",
    546: "left",
    547: "right",
    # Lizard Mode (Steam Deck fallback keyboard events)
    103: "up",      # KEY_UP
    108: "down",    # KEY_DOWN
    105: "left",    # KEY_LEFT
    106: "right",   # KEY_RIGHT
    28: "south",    # KEY_ENTER (A button)
    1: "east",      # KEY_ESC (B button)
}
TRIGGER_SHOULDER_IDS = {"0c12:1e1a"}

ABS_X = 0
ABS_Y = 1
ABS_HAT0X = 16
ABS_HAT0Y = 17
AXIS_THRESHOLD = 20000
AXIS_DEADZONE = 12000


def read_text(path):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return handle.read().strip().lower()
    except OSError:
        return ""


def known_controllers(anvil_root):
    db_path = os.path.join(anvil_root, "config", "controller-devices.db")
    controllers = {}
    try:
        with open(db_path, "r", encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                parts = line.split()
                if len(parts) >= 2:
                    controllers[parts[0].lower()] = {
                        "family": parts[1].lower(),
                        "name": " ".join(parts[2:]) if len(parts) > 2 else parts[0].lower(),
                    }
    except OSError:
        pass
    return controllers


def controller_events(controllers):
    input_root = "/sys/class/input"
    try:
        names = sorted(os.listdir(input_root))
    except OSError:
        return
    for event_name in names:
        if not event_name.startswith("event"):
            continue
        sys_event = os.path.join(input_root, event_name)
        phys = read_text(os.path.join(sys_event, "device", "phys"))
        dev_name = read_text(os.path.join(sys_event, "device", "name"))
        vendor = read_text(os.path.join(sys_event, "device", "id", "vendor"))
        product = read_text(os.path.join(sys_event, "device", "id", "product"))
        controller_id = f"{vendor}:{product}"
        controller = controllers.get(controller_id)
        if not controller:
            continue
        if "28de" in vendor:
            # On Steam Deck, strictly select input2 (gamepad) and ignore input0 (mouse) & input1 (keyboard)
            if "input2" not in phys or "motion" in dev_name:
                continue
        else:
            if "motion" in dev_name or "mouse" in dev_name or "keyboard" in dev_name:
                continue
        dev_path = os.path.join("/dev/input", event_name)
        if os.path.exists(dev_path):
            yield {
                "path": dev_path,
                "id": controller_id,
                "family": controller.get("family") or "xbox",
                "name": controller.get("name") or controller_id,
            }


def daemon_path(anvil_root):
    return os.path.join(anvil_root, "src", "ui", "AnvilDaemon.qml")


def send_action(anvil_root, action, controller):
    family = controller.get("family", "xbox")
    name = controller.get("name", "Controller")
    # Instant stream to parent Quickshell daemon via stdout:
    try:
        print(f"NAV {action} {family} {name}", flush=True)
    except (BrokenPipeError, OSError):
        sys.exit(0)

    # Fallback to IPC if explicitly configured or running standalone
    if os.environ.get("ANVIL_IPC_FALLBACK") == "1":
        env = os.environ.copy()
        if "XDG_RUNTIME_DIR" not in env:
            env["XDG_RUNTIME_DIR"] = f"/run/user/{os.getuid()}"
        if "WAYLAND_DISPLAY" not in env:
            env["WAYLAND_DISPLAY"] = "wayland-1"
        try:
            proc = subprocess.Popen(
                [
                    "qs",
                    "ipc",
                    "--any-display",
                    "-p",
                    daemon_path(anvil_root),
                    "call",
                    "anvil",
                    "navigate",
                    action,
                    family,
                    name,
                ],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                env=env,
                start_new_session=True,
            )
            proc.wait(timeout=0.1)
        except (subprocess.TimeoutExpired, OSError):
            pass


def key_action(code, controller):
    if controller.get("id") in TRIGGER_SHOULDER_IDS:
        if code == 310:
            return "lt"
        if code == 311:
            return "rt"
        if code == 312:
            return "lb"
        if code == 313:
            return "rb"
    return KEY_ACTIONS.get(code)


def announce_controllers(anvil_root, devices, announced):
    for device in devices:
        key = device.get("path") or device.get("id") or device.get("name")
        if not key or key in announced:
            continue
        announced.add(key)
        send_action(anvil_root, "", device)


def axis_action(code, value, axis_state):
    action = None
    if code == ABS_HAT0X:
        if value < 0:
            action = "left"
        elif value > 0:
            action = "right"
        else:
            axis_state.pop(code, None)
    elif code == ABS_HAT0Y:
        if value < 0:
            action = "up"
        elif value > 0:
            action = "down"
        else:
            axis_state.pop(code, None)
    elif code == ABS_X:
        if value < -AXIS_THRESHOLD:
            action = "left"
        elif value > AXIS_THRESHOLD:
            action = "right"
        elif -AXIS_DEADZONE < value < AXIS_DEADZONE:
            axis_state.pop(code, None)
    elif code == ABS_Y:
        if value < -AXIS_THRESHOLD:
            action = "up"
        elif value > AXIS_THRESHOLD:
            action = "down"
        elif -AXIS_DEADZONE < value < AXIS_DEADZONE:
            axis_state.pop(code, None)

    if not action:
        return None
    if axis_state.get(code) == action:
        return None
    axis_state[code] = action
    return action


def main():
    ensure_single_instance('anvil-controller-nav-watch')
    anvil_root = os.environ.get("ANVIL_ROOT", "/usr/local/share/anvil")
    if not anvil_root:
        return 64

    controllers = known_controllers(anvil_root)
    if not controllers:
        return 0

    axis_state = {}
    last_sent = {}
    announced = set()
    guide_down = False
    chord_fired = False

    while True:
        devices = list(controller_events(controllers))
        announce_controllers(anvil_root, devices, announced)
        fds = []
        fd_controllers = {}
        for device in devices:
            try:
                fd = os.open(device["path"], os.O_RDONLY | os.O_NONBLOCK)
                fds.append(fd)
                fd_controllers[fd] = device
            except OSError:
                continue

        if not fds:
            time.sleep(1.0)
            continue

        try:
            while True:
                if os.getppid() == 1:
                    sys.exit(0)
                readable, _, _ = select.select(fds, [], [], 1.0)
                for fd in readable:
                    controller = fd_controllers.get(fd, {})
                    try:
                        data = os.read(fd, EVENT_SIZE * 32)
                    except BlockingIOError:
                        continue
                    except OSError:
                        raise RuntimeError
                    for offset in range(0, len(data) - EVENT_SIZE + 1, EVENT_SIZE):
                        _, _, event_type, code, value = struct.unpack(EVENT_STRUCT, data[offset : offset + EVENT_SIZE])
                        action = None
                        if event_type == EV_KEY:
                            if code in GUIDE_CODES:
                                if value == 1:
                                    guide_down = True
                                    chord_fired = False
                                elif value == 0:
                                    if guide_down:
                                        guide_down = False
                                        if not chord_fired:
                                            action = "guide"
                            elif code in X_CODES and value == 1:
                                if guide_down:
                                    chord_fired = True
                                    action = "keyboard"
                                else:
                                    action = key_action(code, controller)
                            elif code in A_CODES and value == 1:
                                if guide_down:
                                    chord_fired = True
                                    action = "quickaccess"
                                else:
                                    action = key_action(code, controller)
                            elif code in QUICKACCESS_CODES and value == 1:
                                action = "quickaccess"
                            elif value == 1:
                                action = key_action(code, controller)
                        elif event_type == EV_ABS:
                            action = axis_action(code, value, axis_state)
                        if not action:
                            continue
                        now = time.monotonic()
                        cooldown = 0.22 if event_type == EV_ABS else 0.14
                        if now - last_sent.get(action, 0) < cooldown:
                            continue
                        last_sent[action] = now
                        send_action(anvil_root, action, controller)
        except (RuntimeError, OSError, ValueError):
            pass
        finally:
            for fd in fds:
                try:
                    os.close(fd)
                except OSError:
                    pass
        time.sleep(0.5)


if __name__ == "__main__":
    sys.exit(main())
