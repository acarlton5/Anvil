#!/usr/bin/env python3
import os
import select
import struct
import subprocess
import sys
import time

EV_KEY = 1
EV_ABS = 3
# Linux input_event.value is signed; D-pad left/up arrive as -1.
EVENT_STRUCT = "llHHi"
EVENT_SIZE = struct.calcsize(EVENT_STRUCT)

GUIDE_CODES = {172, 316}
QUICKACCESS_CODES = {294, 148, 149, 217}
X_CODES = {308}

KEY_ACTIONS = {
    304: "south",
    305: "east",
    307: "north",
    308: "west",
    310: "lb",
    311: "rb",
    312: "lt",
    313: "rt",
    314: "back",
    315: "start",
    316: "guide",
    172: "guide",
    294: "quickaccess",
    544: "up",
    545: "down",
    546: "left",
    547: "right",
    # Lizard Mode (Steam Deck fallback keyboard events)
    103: "up",      # KEY_UP
    108: "down",    # KEY_DOWN
    105: "left",    # KEY_LEFT
    106: "right",   # KEY_RIGHT
    28: "south",    # KEY_ENTER (A button)
    1: "east",      # KEY_ESC (B button)
}
TRIGGER_SHOULDER_IDS = {"0c12:1e1a"}

ABS_X = 0
ABS_Y = 1
ABS_HAT0X = 16
ABS_HAT0Y = 17
AXIS_THRESHOLD = 16000
AXIS_DEADZONE = 8000


def read_text(path):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return handle.read().strip().lower()
    except OSError:
        return ""


def known_controllers(anvil_root):
    db_path = os.path.join(anvil_root, "config", "controller-devices.db")
    controllers = {}
    try:
        with open(db_path, "r", encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                parts = line.split()
                if len(parts) >= 2:
                    controllers[parts[0].lower()] = {
                        "family": parts[1].lower(),
                        "name": " ".join(parts[2:]) if len(parts) > 2 else parts[0].lower(),
                    }
    except OSError:
        pass
    return controllers


def controller_events(controllers):
    input_root = "/sys/class/input"
    try:
        names = sorted(os.listdir(input_root))
    except OSError:
        return
    for event_name in names:
        if not event_name.startswith("event"):
            continue
        sys_event = os.path.join(input_root, event_name)
        dev_name = read_text(os.path.join(sys_event, "device", "name"))
        if "motion" in dev_name or "mouse" in dev_name:
            continue
        vendor = read_text(os.path.join(sys_event, "device", "id", "vendor"))
        product = read_text(os.path.join(sys_event, "device", "id", "product"))
        controller_id = f"{vendor}:{product}"
        controller = controllers.get(controller_id)
        if not controller:
            continue
        dev_path = os.path.join("/dev/input", event_name)
        if os.path.exists(dev_path):
            yield {
                "path": dev_path,
                "id": controller_id,
                "family": controller.get("family") or "xbox",
                "name": controller.get("name") or controller_id,
            }


def daemon_path(anvil_root):
    return os.path.join(anvil_root, "src", "ui", "AnvilDaemon.qml")


def deck_hidraw_devices():
    hid_dir = "/sys/class/hidraw"
    if not os.path.isdir(hid_dir):
        return []
    res = []
    for entry in sorted(os.listdir(hid_dir)):
        if entry != "hidraw2": continue
        dev_path = os.path.join("/dev", entry)
        if not os.path.exists(dev_path):
            continue
        try:
            uevent_path = os.path.join(hid_dir, entry, "device", "uevent")
            if os.path.exists(uevent_path):
                with open(uevent_path, "r", errors="ignore") as f:
                    u = f.read().lower()
                    if ("28de" in u and ("1205" in u or "11ff" in u)) or ("hid-steam" in u):
                        res.append(dev_path)
        except OSError:
            pass
    return res

def send_action(anvil_root, action, controller):
    subprocess.Popen(
        [
            "qs",
            "ipc",
            "--any-display",
            "-p",
            daemon_path(anvil_root),
            "call",
            "anvil",
            "navigate",
            action,
            controller.get("family", "xbox"),
            controller.get("name", ""),
        ],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def key_action(code, controller):
    if controller.get("id") in TRIGGER_SHOULDER_IDS:
        if code == 310:
            return "lt"
        if code == 311:
            return "rt"
        if code == 312:
            return "lb"
        if code == 313:
            return "rb"
    return KEY_ACTIONS.get(code)


def announce_controllers(anvil_root, devices, announced):
    for device in devices:
        key = device.get("path") or device.get("id") or device.get("name")
        if not key or key in announced:
            continue
        announced.add(key)
        send_action(anvil_root, "", device)


def axis_action(code, value, axis_state):
    action = None
    if code == ABS_HAT0X:
        if value < 0:
            action = "left"
        elif value > 0:
            action = "right"
        else:
            axis_state.pop(code, None)
    elif code == ABS_HAT0Y:
        if value < 0:
            action = "up"
        elif value > 0:
            action = "down"
        else:
            axis_state.pop(code, None)
    elif code == ABS_X:
        if value < -AXIS_THRESHOLD:
            action = "left"
        elif value > AXIS_THRESHOLD:
            action = "right"
        elif -AXIS_DEADZONE < value < AXIS_DEADZONE:
            axis_state.pop(code, None)
    elif code == ABS_Y:
        if value < -AXIS_THRESHOLD:
            action = "up"
        elif value > AXIS_THRESHOLD:
            action = "down"
        elif -AXIS_DEADZONE < value < AXIS_DEADZONE:
            axis_state.pop(code, None)

    if not action:
        return None
    if axis_state.get(code) == action:
        return None
    axis_state[code] = action
    return action


def main():
    anvil_root = os.environ.get("ANVIL_ROOT", "/usr/local/share/anvil")
    if not anvil_root:
        return 64

    controllers = known_controllers(anvil_root)
    if not controllers:
        return 0

    axis_state = {}
    last_sent = {}
    announced = set()
    guide_down = False
    chord_fired = False

    while True:
        devices = list(controller_events(controllers))
        announce_controllers(anvil_root, devices, announced)
        hid_paths = deck_hidraw_devices()
        fds = []
        fd_controllers = {}
        fd_types = {}
        for device in devices:
            try:
                fd = os.open(device["path"], os.O_RDONLY | os.O_NONBLOCK)
                fds.append(fd)
                fd_controllers[fd] = device
                fd_types[fd] = "evdev"
            except OSError:
                continue
        for hp in hid_paths:
            try:
                fd = os.open(hp, os.O_RDONLY | os.O_NONBLOCK)
                fds.append(fd)
                fd_types[fd] = "hidraw"
            except OSError:
                continue

        if not fds:
            time.sleep(1.0)
            continue

        try:
            while True:
                readable, _, _ = select.select(fds, [], [], 1.0)
                for fd in readable:
                    if fd_types.get(fd) == "hidraw":
                        try:
                            pkt = os.read(fd, 64)
                        except (BlockingIOError, OSError):
                            continue
                        if len(pkt) > 13 and (pkt[13] & 0x40):
                            now = time.monotonic()
                            if now - last_sent.get("quickaccess", 0) >= 0.35:
                                last_sent["quickaccess"] = now
                                send_action(anvil_root, "quickaccess", {"family": "steamdeck", "name": "Steam Deck"})
                        continue

                    controller = fd_controllers.get(fd, {})
                    try:
                        data = os.read(fd, EVENT_SIZE * 32)
                    except BlockingIOError:
                        continue
                    except OSError:
                        raise RuntimeError
                    for offset in range(0, len(data) - EVENT_SIZE + 1, EVENT_SIZE):
                        _, _, event_type, code, value = struct.unpack(EVENT_STRUCT, data[offset : offset + EVENT_SIZE])
                        action = None
                        if event_type == EV_KEY:
                            if code in GUIDE_CODES:
                                if value == 1:
                                    guide_down = True
                                    chord_fired = False
                                elif value == 0:
                                    if guide_down:
                                        guide_down = False
                                        if not chord_fired:
                                            action = "guide"
                            elif code in X_CODES and value == 1:
                                if guide_down:
                                    chord_fired = True
                                    action = "keyboard"
                                else:
                                    action = key_action(code, controller)
                            elif code in QUICKACCESS_CODES and value == 1:
                                action = "quickaccess"
                            elif value == 1:
                                action = key_action(code, controller)
                        elif event_type == EV_ABS:
                            action = axis_action(code, value, axis_state)
                        if not action:
                            continue
                        now = time.monotonic()
                        if now - last_sent.get(action, 0) < 0.18:
                            continue
                        last_sent[action] = now
                        send_action(anvil_root, action, controller)
        except RuntimeError:
            pass
        finally:
            for fd in fds:
                try:
                    os.close(fd)
                except OSError:
                    pass
        time.sleep(0.5)


if __name__ == "__main__":
    sys.exit(main())
