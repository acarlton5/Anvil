#!/usr/bin/env python3
import os
import select
import struct
import subprocess
import sys
import time

EV_KEY = 1
EV_ABS = 3
EVENT_STRUCT = "llHHI"
EVENT_SIZE = struct.calcsize(EVENT_STRUCT)

KEY_ACTIONS = {
    304: "south",
    305: "east",
    307: "north",
    308: "west",
    310: "lb",
    311: "rb",
    314: "back",
    315: "start",
    316: "guide",
    172: "guide",
}

ABS_X = 0
ABS_Y = 1
ABS_HAT0X = 16
ABS_HAT0Y = 17
AXIS_LOW = 12000
AXIS_HIGH = 52000


def read_text(path):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return handle.read().strip().lower()
    except OSError:
        return ""


def known_controller_ids(anvil_root):
    db_path = os.path.join(anvil_root, "config", "controller-devices.db")
    ids = set()
    try:
        with open(db_path, "r", encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                parts = line.split()
                if parts:
                    ids.add(parts[0].lower())
    except OSError:
        pass
    return ids


def controller_events(controller_ids):
    input_root = "/sys/class/input"
    try:
        names = sorted(os.listdir(input_root))
    except OSError:
        return
    for event_name in names:
        if not event_name.startswith("event"):
            continue
        sys_event = os.path.join(input_root, event_name)
        vendor = read_text(os.path.join(sys_event, "device", "id", "vendor"))
        product = read_text(os.path.join(sys_event, "device", "id", "product"))
        if f"{vendor}:{product}" not in controller_ids:
            continue
        dev_path = os.path.join("/dev/input", event_name)
        if os.path.exists(dev_path):
            yield dev_path


def daemon_path(anvil_root):
    return os.path.join(anvil_root, "src", "ui", "AnvilDaemon.qml")


def send_action(anvil_root, action):
    subprocess.Popen(
        ["qs", "ipc", "--any-display", "-p", daemon_path(anvil_root), "call", "anvil", "navigate", action],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def axis_action(code, value, axis_state):
    action = None
    if code == ABS_HAT0X:
        if value < 0:
            action = "left"
        elif value > 0:
            action = "right"
        else:
            axis_state.pop(code, None)
    elif code == ABS_HAT0Y:
        if value < 0:
            action = "up"
        elif value > 0:
            action = "down"
        else:
            axis_state.pop(code, None)
    elif code == ABS_X:
        if value < AXIS_LOW:
            action = "left"
        elif value > AXIS_HIGH:
            action = "right"
        else:
            axis_state.pop(code, None)
    elif code == ABS_Y:
        if value < AXIS_LOW:
            action = "up"
        elif value > AXIS_HIGH:
            action = "down"
        else:
            axis_state.pop(code, None)

    if not action:
        return None
    if axis_state.get(code) == action:
        return None
    axis_state[code] = action
    return action


def main():
    anvil_root = os.environ.get("ANVIL_ROOT", "")
    if not anvil_root:
        return 64

    controller_ids = known_controller_ids(anvil_root)
    if not controller_ids:
        return 0

    axis_state = {}
    last_sent = {}

    while True:
        paths = list(controller_events(controller_ids))
        fds = []
        for path in paths:
            try:
                fds.append(os.open(path, os.O_RDONLY | os.O_NONBLOCK))
            except OSError:
                continue

        if not fds:
            time.sleep(1.0)
            continue

        try:
            while True:
                readable, _, _ = select.select(fds, [], [], 1.0)
                for fd in readable:
                    try:
                        data = os.read(fd, EVENT_SIZE * 32)
                    except BlockingIOError:
                        continue
                    except OSError:
                        raise RuntimeError
                    for offset in range(0, len(data) - EVENT_SIZE + 1, EVENT_SIZE):
                        _, _, event_type, code, value = struct.unpack(EVENT_STRUCT, data[offset : offset + EVENT_SIZE])
                        action = None
                        if event_type == EV_KEY and value == 1:
                            action = KEY_ACTIONS.get(code)
                        elif event_type == EV_ABS:
                            action = axis_action(code, value, axis_state)
                        if not action:
                            continue
                        now = time.monotonic()
                        if now - last_sent.get(action, 0) < 0.18:
                            continue
                        last_sent[action] = now
                        send_action(anvil_root, action)
        except RuntimeError:
            pass
        finally:
            for fd in fds:
                try:
                    os.close(fd)
                except OSError:
                    pass
        time.sleep(0.5)


if __name__ == "__main__":
    sys.exit(main())
