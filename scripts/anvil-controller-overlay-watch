#!/usr/bin/env python3
import fcntl
import os
import select
import struct
import subprocess
import sys
import time

_lock_fd = None

def ensure_single_instance(name):
    global _lock_fd
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime_dir or not os.path.isdir(runtime_dir):
        runtime_dir = "/tmp"
    lock_file = os.path.join(runtime_dir, f"{name}_{os.getuid()}.lock")
    try:
        _lock_fd = os.open(lock_file, os.O_CREAT | os.O_RDWR, 0o600)
        fcntl.flock(_lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (BlockingIOError, OSError):
        sys.exit(0)

EV_KEY = 1
DEFAULT_GUIDE_CODES = {172, 316}
DEFAULT_QUICKACCESS_CODES = {294, 148, 149, 217}
DEFAULT_X_CODES = {307, 308}
DEFAULT_A_CODES = {304}
EVENT_STRUCT = "llHHi"
EVENT_SIZE = struct.calcsize(EVENT_STRUCT)


def read_text(path):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return handle.read().strip().lower()
    except OSError:
        return ""


def guide_codes():
    raw = os.environ.get("ANVIL_OVERLAY_GUIDE_CODES", "")
    if not raw:
        return set(DEFAULT_GUIDE_CODES)
    codes = set()
    for item in raw.split(","):
        item = item.strip()
        if item.isdigit():
            codes.add(int(item))
    return codes or set(DEFAULT_GUIDE_CODES)


def quickaccess_codes():
    raw = os.environ.get("ANVIL_OVERLAY_QUICKACCESS_CODES", "")
    if not raw:
        return set(DEFAULT_QUICKACCESS_CODES)
    codes = set()
    for item in raw.split(","):
        item = item.strip()
        if item.isdigit():
            codes.add(int(item))
    return codes or set(DEFAULT_QUICKACCESS_CODES)


def known_controller_ids(anvil_root):
    db_path = os.path.join(anvil_root, "config", "controller-devices.db")
    ids = set()
    try:
        with open(db_path, "r", encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                parts = line.split()
                if not parts:
                    continue
                ids.add(parts[0].lower())
    except OSError:
        pass
    return ids


def joystick_events(controller_ids):
    input_root = "/sys/class/input"
    for event_name in sorted(os.listdir(input_root)):
        if not event_name.startswith("event"):
            continue
        sys_event = os.path.join(input_root, event_name)
        phys = read_text(os.path.join(sys_event, "device", "phys"))
        dev_name = read_text(os.path.join(sys_event, "device", "name"))
        vendor = read_text(os.path.join(sys_event, "device", "id", "vendor"))
        product = read_text(os.path.join(sys_event, "device", "id", "product"))
        if f"{vendor}:{product}" not in controller_ids:
            continue
        if "28de" in vendor:
            # On Steam Deck, strictly select input2 (gamepad) and ignore input0 (mouse) & input1 (keyboard)
            if "input2" not in phys or "motion" in dev_name:
                continue
        else:
            if "motion" in dev_name or "mouse" in dev_name or "keyboard" in dev_name:
                continue
        dev_path = os.path.join("/dev/input", event_name)
        if os.path.exists(dev_path):
            yield dev_path


def deck_hidraw_devices():
    # Do not open hidraw to avoid kernel hid-steam disconnect/reset storm
    return []


def run_toggle(script_name, anvil_root):
    env = os.environ.copy()
    if "XDG_RUNTIME_DIR" not in env:
        env["XDG_RUNTIME_DIR"] = f"/run/user/{os.getuid()}"
    if "WAYLAND_DISPLAY" not in env:
        env["WAYLAND_DISPLAY"] = "wayland-1"
    toggle = os.path.join(anvil_root, "scripts", script_name)
    try:
        proc = subprocess.Popen(
            [toggle, anvil_root],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            env=env,
            start_new_session=True,
        )
        proc.wait(timeout=0.2)
    except Exception:
        pass


def toggle_overlay(anvil_root):
    run_toggle("anvil-overlay-toggle", anvil_root)


def toggle_quickaccess(anvil_root):
    run_toggle("anvil-quickaccess-toggle", anvil_root)


def toggle_keyboard(anvil_root):
    run_toggle("anvil-keyboard-toggle", anvil_root)


def main():
    ensure_single_instance('anvil-controller-overlay-watch')
    anvil_root = os.environ.get("ANVIL_ROOT", "/usr/local/share/anvil")
    if not anvil_root:
        return 64

    g_codes = guide_codes()
    qa_codes = quickaccess_codes()
    x_codes = set(DEFAULT_X_CODES)
    a_codes = set(DEFAULT_A_CODES)

    last_guide = 0.0
    last_qa = 0.0
    last_kb = 0.0
    guide_down = False
    chord_fired = False

    while True:
        controller_ids = known_controller_ids(anvil_root)
        if not controller_ids:
            time.sleep(2.0)
            continue

        paths = list(joystick_events(controller_ids))
        all_targets = [("evdev", p) for p in paths]

        if not all_targets:
            time.sleep(1.0)
            continue

        fds = []
        for kind, path in all_targets:
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
                fds.append(fd)
            except OSError:
                continue

        if not fds:
            time.sleep(1.0)
            continue

        try:
            while True:
                readable, _, _ = select.select(fds, [], [], 1.5)
                if not readable:
                    continue

                for fd in readable:
                    try:
                        data = os.read(fd, EVENT_SIZE * 32)
                    except BlockingIOError:
                        continue
                    except OSError:
                        raise RuntimeError

                    for offset in range(0, len(data) - EVENT_SIZE + 1, EVENT_SIZE):
                        _, _, event_type, code, value = struct.unpack(
                            EVENT_STRUCT, data[offset : offset + EVENT_SIZE]
                        )
                        if event_type != EV_KEY:
                            continue

                        now = time.monotonic()
                        if code in g_codes:
                            if value == 1:
                                guide_down = True
                                chord_fired = False
                            elif value == 0:
                                if guide_down:
                                    guide_down = False
                                    if not chord_fired and (now - last_guide >= 0.5):
                                        last_guide = now
                                        toggle_overlay(anvil_root)
                        elif code in x_codes and value == 1:
                            if guide_down:
                                chord_fired = True
                                if now - last_kb >= 0.5:
                                    last_kb = now
                                    toggle_keyboard(anvil_root)
                        elif code in a_codes and value == 1:
                            if guide_down:
                                chord_fired = True
                                if now - last_qa >= 0.5:
                                    last_qa = now
                                    toggle_quickaccess(anvil_root)
                        elif code in qa_codes and value == 1:
                            if now - last_qa >= 0.5:
                                last_qa = now
                                toggle_quickaccess(anvil_root)
        except (RuntimeError, OSError, ValueError):
            pass
        finally:
            for fd in fds:
                try:
                    os.close(fd)
                except OSError:
                    pass
        time.sleep(0.5)


if __name__ == "__main__":
    sys.exit(main())
