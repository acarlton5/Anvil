#!/usr/bin/env python3
import fcntl

_lock_fd = None
def ensure_single_instance(name):
    global _lock_fd
    lock_file = f"/tmp/{name}.lock"
    try:
        _lock_fd = os.open(lock_file, os.O_CREAT | os.O_RDWR)
        fcntl.flock(_lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (BlockingIOError, OSError):
        sys.exit(0)
import os
import select
import struct
import subprocess
import sys
import time

EV_KEY = 1
DEFAULT_GUIDE_CODES = {172, 316}
DEFAULT_QUICKACCESS_CODES = {294, 148, 149, 217}
DEFAULT_X_CODES = {308}
EVENT_STRUCT = "llHHi"
EVENT_SIZE = struct.calcsize(EVENT_STRUCT)


def read_text(path):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return handle.read().strip().lower()
    except OSError:
        return ""


def known_controller_ids(anvil_root):
    db_path = os.path.join(anvil_root, "config", "controller-devices.db")
    ids = set()
    try:
        with open(db_path, "r", encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                parts = line.split()
                if not parts:
                    continue
                ids.add(parts[0].lower())
    except OSError:
        pass
    return ids


def joystick_events(controller_ids):
    input_root = "/sys/class/input"
    for event_name in sorted(os.listdir(input_root)):
        if not event_name.startswith("event"):
            continue
        sys_event = os.path.join(input_root, event_name)
        dev_name = read_text(os.path.join(sys_event, "device", "name"))
        if "motion" in dev_name or "mouse" in dev_name:
            continue
        vendor = read_text(os.path.join(sys_event, "device", "id", "vendor"))
        product = read_text(os.path.join(sys_event, "device", "id", "product"))
        if f"{vendor}:{product}" not in controller_ids:
            continue
        dev_path = os.path.join("/dev/input", event_name)
        if os.path.exists(dev_path):
            yield dev_path


def deck_hidraw_devices():
    # Valve Steam Deck controller endpoints on hidraw
    hid_dir = "/sys/class/hidraw"
    if not os.path.isdir(hid_dir):
        return []
    res = []
    for entry in sorted(os.listdir(hid_dir)):
        if entry != "hidraw2": continue
        dev_path = os.path.join("/dev", entry)
        if not os.path.exists(dev_path):
            continue
        try:
            uevent_path = os.path.join(hid_dir, entry, "device", "uevent")
            if os.path.exists(uevent_path):
                with open(uevent_path, "r", errors="ignore") as f:
                    u = f.read().lower()
                    if ("28de" in u and ("1205" in u or "11ff" in u)) or ("hid-steam" in u):
                        res.append(dev_path)
        except OSError:
            pass
    return res


def guide_codes():
    raw = os.environ.get("ANVIL_OVERLAY_BUTTON_CODES", "")
    codes = set(DEFAULT_GUIDE_CODES)
    for item in raw.replace(",", " ").split():
        try:
            codes.add(int(item, 0))
        except ValueError:
            pass
    return codes


def quickaccess_codes():
    raw = os.environ.get("ANVIL_QUICKACCESS_BUTTON_CODES", "")
    codes = set(DEFAULT_QUICKACCESS_CODES)
    for item in raw.replace(",", " ").split():
        try:
            codes.add(int(item, 0))
        except ValueError:
            pass
    return codes


def toggle_overlay(anvil_root):
    toggle = os.path.join(anvil_root, "scripts", "anvil-overlay-toggle")
    subprocess.Popen(
        [toggle, anvil_root],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def toggle_quickaccess(anvil_root):
    toggle = os.path.join(anvil_root, "scripts", "anvil-quickaccess-toggle")
    subprocess.Popen(
        [toggle, anvil_root],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def toggle_keyboard(anvil_root):
    toggle = os.path.join(anvil_root, "scripts", "anvil-keyboard-toggle")
    subprocess.Popen(
        [toggle, anvil_root],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def main():
    ensure_single_instance('anvil-controller-overlay-watch')
    anvil_root = os.environ.get("ANVIL_ROOT", "/usr/local/share/anvil")
    if not anvil_root:
        return 64

    g_codes = guide_codes()
    qa_codes = quickaccess_codes()
    x_codes = set(DEFAULT_X_CODES)

    last_guide = 0.0
    last_qa = 0.0
    last_kb = 0.0
    guide_down = False
    chord_fired = False

    while True:
        controller_ids = known_controller_ids(anvil_root)
        if not controller_ids:
            time.sleep(2.0)
            continue

        paths = list(joystick_events(controller_ids))
        hid_paths = deck_hidraw_devices()
        all_targets = [("evdev", p) for p in paths] + [("hidraw", p) for p in hid_paths]

        if not all_targets:
            time.sleep(1.0)
            continue

        fds = []
        fd_types = {}
        for kind, path in all_targets:
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
                fds.append(fd)
                fd_types[fd] = kind
            except OSError:
                continue

        if not fds:
            time.sleep(1.0)
            continue

        try:
            while True:
                readable, _, _ = select.select(fds, [], [], 1.5)
                if not readable:
                    current_paths = set(joystick_events(controller_ids))
                    current_hid = set(deck_hidraw_devices())
                    if current_paths != set(paths) or current_hid != set(hid_paths):
                        break
                    continue

                for fd in readable:
                    kind = fd_types.get(fd)
                    if kind == "hidraw":
                        try:
                            pkt = os.read(fd, 64)
                        except (BlockingIOError, OSError):
                            continue
                        # Deck hardware reports QuickAccess (...) button on hidraw:
                        # byte 13 bit 0x40 is set when ... is pressed
                        if len(pkt) > 13 and (pkt[13] & 0x40):
                            now = time.monotonic()
                            if now - last_qa >= 0.35:
                                last_qa = now
                                toggle_quickaccess(anvil_root)
                        continue

                    # evdev events
                    try:
                        data = os.read(fd, EVENT_SIZE * 32)
                    except BlockingIOError:
                        continue
                    except OSError:
                        raise RuntimeError

                    for offset in range(0, len(data) - EVENT_SIZE + 1, EVENT_SIZE):
                        _, _, event_type, code, value = struct.unpack(
                            EVENT_STRUCT, data[offset : offset + EVENT_SIZE]
                        )
                        if event_type != EV_KEY:
                            continue

                        now = time.monotonic()
                        if code in g_codes:
                            if value == 1:
                                guide_down = True
                                chord_fired = False
                            elif value == 0:
                                if guide_down:
                                    guide_down = False
                                    if not chord_fired and (now - last_guide >= 0.3):
                                        last_guide = now
                                        toggle_overlay(anvil_root)
                        elif code in x_codes and value == 1:
                            if guide_down:
                                chord_fired = True
                                if now - last_kb >= 0.3:
                                    last_kb = now
                                    toggle_keyboard(anvil_root)
                        elif code in qa_codes and value == 1:
                            if now - last_qa >= 0.3:
                                last_qa = now
                                toggle_quickaccess(anvil_root)
        except RuntimeError:
            pass
        finally:
            for fd in fds:
                try:
                    os.close(fd)
                except OSError:
                    pass
        time.sleep(0.5)


if __name__ == "__main__":
    sys.exit(main())
