#!/usr/bin/env bash
set -euo pipefail

anvil_root="${1:-${ANVIL_ROOT:-}}"
if [ -z "$anvil_root" ]; then
    for candidate in \
        "/usr/local/share/anvil" \
        "$HOME/.config/HypeShell/plugins/hypeAnvil" \
        "$HOME/Projects/Projects/Anvil" \
        "$HOME/DevBox/Projects/Anvil" \
        "$HOME/Projects/Anvil"; do
        if [ -f "$candidate/src/ui/AnvilDaemon.qml" ]; then
            anvil_root="$candidate"
            break
        fi
    done
fi

if [ -z "$anvil_root" ] || [ ! -f "$anvil_root/src/ui/AnvilDaemon.qml" ]; then
    echo "Anvil root not found for quick access toggle." >&2
    exit 1
fi

daemon="$anvil_root/src/ui/AnvilDaemon.qml"
qs ipc --any-display -p "$daemon" call anvil toggleQuickAccess >/dev/null 2>&1 || true
