#!/usr/bin/env python3
import json
import os
import re
import subprocess
import sys

def run_wpctl(args):
    env = os.environ.copy()
    if "XDG_RUNTIME_DIR" not in env:
        uid = os.getuid()
        if uid == 0:
            env["XDG_RUNTIME_DIR"] = "/run/user/1000"
        else:
            env["XDG_RUNTIME_DIR"] = f"/run/user/{uid}"
    try:
        res = subprocess.run(["wpctl"] + args, env=env, capture_output=True, text=True, check=True)
        return res.stdout
    except Exception:
        return ""

def get_audio_info():
    out = run_wpctl(["status"])
    sinks = []
    sources = []
    section = None
    for line in out.splitlines():
        if "Sinks:" in line:
            section = "sinks"
            continue
        elif "Sources:" in line:
            section = "sources"
            continue
        elif "Filters:" in line or "Streams:" in line or "Video" in line:
            section = None
            continue

        if section in ("sinks", "sources"):
            m = re.search(r"([*]?)\s+(\d+)\.\s+(.*?)\s+\[vol:\s+([0-9.]+)(.*?)]", line)
            if m:
                is_default = (m.group(1) == "*")
                name = m.group(3).strip()
                vol = float(m.group(4))
                muted = "MUTED" in m.group(5)
                item = {
                    "id": int(m.group(2)),
                    "name": name,
                    "volume": int(round(vol * 100)),
                    "volume_frac": vol,
                    "muted": muted,
                    "default": is_default
                }
                if section == "sinks":
                    sinks.append(item)
                else:
                    sources.append(item)

    curr_sink = next((s for s in sinks if s["default"]), sinks[0] if sinks else None)
    curr_source = next((s for s in sources if s["default"]), sources[0] if sources else None)

    return {
        "sinks": sinks,
        "sources": sources,
        "current_sink": curr_sink,
        "current_source": curr_source
    }

def cycle_sink():
    info = get_audio_info()
    sinks = info["sinks"]
    if not sinks:
        return
    curr_idx = 0
    for idx, s in enumerate(sinks):
        if s["default"]:
            curr_idx = idx
            break
    next_sink = sinks[(curr_idx + 1) % len(sinks)]
    run_wpctl(["set-default", str(next_sink["id"])])

def cycle_source():
    info = get_audio_info()
    sources = info["sources"]
    if not sources:
        return
    curr_idx = 0
    for idx, s in enumerate(sources):
        if s["default"]:
            curr_idx = idx
            break
    next_source = sources[(curr_idx + 1) % len(sources)]
    run_wpctl(["set-default", str(next_source["id"])])

def set_volume(val_str):
    try:
        val = float(val_str)
        if val > 1.0:
            val = val / 100.0
        val = max(0.0, min(1.0, val))
        run_wpctl(["set-volume", "-l", "1.0", "@DEFAULT_AUDIO_SINK@", f"{val:.2f}"])
    except ValueError:
        pass

def set_mic_volume(val_str):
    try:
        val = float(val_str)
        if val > 1.0:
            val = val / 100.0
        val = max(0.0, min(1.0, val))
        run_wpctl(["set-volume", "-l", "1.0", "@DEFAULT_AUDIO_SOURCE@", f"{val:.2f}"])
    except ValueError:
        pass

def toggle_mute():
    run_wpctl(["set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"])

def toggle_mic_mute():
    run_wpctl(["set-mute", "@DEFAULT_AUDIO_SOURCE@", "toggle"])

def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "status":
        print(json.dumps(get_audio_info()))
    elif cmd == "cycle-sink":
        cycle_sink()
        print(json.dumps(get_audio_info()))
    elif cmd == "cycle-source":
        cycle_source()
        print(json.dumps(get_audio_info()))
    elif cmd == "set-volume" and len(sys.argv) > 2:
        set_volume(sys.argv[2])
    elif cmd == "set-mic-volume" and len(sys.argv) > 2:
        set_mic_volume(sys.argv[2])
    elif cmd == "toggle-mute":
        toggle_mute()
    elif cmd == "toggle-mic-mute":
        toggle_mic_mute()
    else:
        print(f"Unknown command: {cmd}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
