#!/usr/bin/env bash
set -euo pipefail

runtime_root="${XDG_RUNTIME_DIR:-/tmp}/anvil"
state_dir="$runtime_root/game-session"
pid_file="$state_dir/pid"
meta_file="$state_dir/current.env"
sdl_runtime_db_file="$state_dir/sdl-gamecontrollerdb.txt"
watcher_pid_file="$state_dir/controller-overlay-watch.pid"
anvil_root="${ANVIL_ROOT:-}"
sdl_controller_db="${ANVIL_SDL_CONTROLLER_DB:-}"

usage() {
    echo "usage: anvil-game-session run [--name NAME] [--game-id ID] [--input-profile PROFILE] [--input-map MAP] [--controller-layout LAYOUT] [--achievement-set SET] [--achievements-url URL] -- COMMAND" >&2
    echo "       anvil-game-session stop" >&2
    exit 64
}

read_meta_value() {
    local key="$1"

    [ -f "$meta_file" ] || return 0
    (
        set +u
        # current.env is written by this script with shell-escaped values.
        . "$meta_file" 2>/dev/null || exit 0
        eval "printf '%s' \"\${$key:-}\""
    )
}

session_env_pids() {
    local session_id="$1"
    local proc=""
    local pid=""

    [ -n "$session_id" ] || return 0

    for proc in /proc/[0-9]*; do
        pid="${proc##*/}"
        [ "$pid" != "$$" ] || continue
        [ -r "$proc/environ" ] || continue
        if cat "$proc/environ" 2>/dev/null | tr '\0' '\n' | grep -Fxq "ANVIL_GAME_SESSION_ID=$session_id"; then
            printf '%s\n' "$pid"
        fi
    done
}

signal_session_processes() {
    local signal="$1"
    local pid="$2"
    local session_id="$3"
    local child_pid=""

    if [ -n "$pid" ]; then
        kill "-$signal" -- "-$pid" 2>/dev/null || true
        kill "-$signal" "$pid" 2>/dev/null || true
        if command -v pkill >/dev/null 2>&1; then
            pkill "-$signal" -s "$pid" 2>/dev/null || true
        fi
    fi

    while read -r child_pid; do
        [ -n "$child_pid" ] || continue
        kill "-$signal" "$child_pid" 2>/dev/null || true
    done <<EOF
$(session_env_pids "$session_id")
EOF
}

session_still_running() {
    local pid="$1"
    local session_id="$2"

    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        return 0
    fi

    if [ -n "$(session_env_pids "$session_id")" ]; then
        return 0
    fi

    return 1
}

stop_session() {
    stop_overlay_watcher

    local session_id
    session_id="$(read_meta_value ANVIL_GAME_SESSION_ID)"

    if [ ! -s "$pid_file" ]; then
        if [ -n "$session_id" ]; then
            signal_session_processes TERM "" "$session_id"
            sleep 0.3
            signal_session_processes KILL "" "$session_id"
        fi
        return 0
    fi

    local pid
    pid="$(cat "$pid_file" 2>/dev/null || true)"
    if [ -z "$pid" ]; then
        signal_session_processes TERM "" "$session_id"
        sleep 0.3
        signal_session_processes KILL "" "$session_id"
        rm -f "$pid_file" "$meta_file" "$sdl_runtime_db_file" "$watcher_pid_file"
        return 0
    fi

    signal_session_processes TERM "$pid" "$session_id"

    local waited=0
    while session_still_running "$pid" "$session_id" && [ "$waited" -lt 30 ]; do
        sleep 0.1
        waited=$((waited + 1))
    done

    if session_still_running "$pid" "$session_id"; then
        signal_session_processes KILL "$pid" "$session_id"
    fi

    rm -f "$pid_file" "$meta_file" "$sdl_runtime_db_file" "$watcher_pid_file"
}

stop_overlay_watcher() {
    if [ ! -s "$watcher_pid_file" ]; then
        return 0
    fi

    local watcher_pid
    watcher_pid="$(cat "$watcher_pid_file" 2>/dev/null || true)"
    if [ -n "$watcher_pid" ] && kill -0 "$watcher_pid" 2>/dev/null; then
        kill -TERM "$watcher_pid" 2>/dev/null || true
    fi
    rm -f "$watcher_pid_file"
}

write_meta() {
    local name="$1"
    local game_id="$2"
    local session_id="$3"
    local input_profile="$4"
    local input_map="$5"
    local controller_layout="$6"
    local achievement_set="$7"
    local achievements_url="$8"

    {
        printf 'ANVIL_GAME_NAME=%q\n' "$name"
        printf 'ANVIL_GAME_ID=%q\n' "$game_id"
        printf 'ANVIL_GAME_SESSION_ID=%q\n' "$session_id"
        printf 'ANVIL_INPUT_PROFILE=%q\n' "$input_profile"
        printf 'ANVIL_INPUT_MAP=%q\n' "$input_map"
        printf 'ANVIL_INPUT_MAP_FILE=%q\n' "$(input_map_file "$input_map")"
        printf 'ANVIL_CONTROLLER_FAMILY=%q\n' "$(active_controller_family)"
        printf 'ANVIL_CONTROLLER_LAYOUT=%q\n' "$controller_layout"
        printf 'ANVIL_CONTROLLER_LAYOUT_FILE=%q\n' "$(controller_layout_file "$controller_layout")"
        printf 'ANVIL_ACHIEVEMENT_SET=%q\n' "$achievement_set"
        printf 'ANVIL_ACHIEVEMENT_SET_FILE=%q\n' "$(achievement_set_file "$achievement_set")"
        printf 'ANVIL_ACHIEVEMENTS_URL=%q\n' "$achievements_url"
        printf 'ANVIL_SDL_CONTROLLER_DB=%q\n' "$(sdl_controller_db_file)"
        printf 'ANVIL_STARTED_AT=%q\n' "$(date -Iseconds)"
    } > "$meta_file"
}

achievement_set_file() {
    local achievement_set="$1"
    local candidate=""

    [ -n "$achievement_set" ] || return 0

    if [ -f "$achievement_set" ]; then
        printf '%s' "$achievement_set"
        return
    fi

    if [ -n "$anvil_root" ]; then
        candidate="$anvil_root/config/achievements/$achievement_set"
        if [ -f "$candidate" ]; then
            printf '%s' "$candidate"
            return
        fi
    fi

    printf ''
}

input_map_file() {
    local map="$1"
    local candidate=""

    [ -n "$map" ] || return 0

    if [ -f "$map" ]; then
        printf '%s' "$map"
        return
    fi

    if [ -n "$anvil_root" ]; then
        candidate="$anvil_root/config/input-maps/$map"
        if [ -f "$candidate" ]; then
            printf '%s' "$candidate"
            return
        fi
    fi

    printf ''
}

active_controller_family() {
    local db_file=""
    local line=""
    local vendor=""
    local product=""

    if [ -n "$anvil_root" ]; then
        db_file="$anvil_root/config/controller-devices.db"
    fi
    [ -f "$db_file" ] || return 0

    while read -r line; do
        case "$line" in
            I:*)
                vendor="$(printf '%s\n' "$line" | sed -n 's/.*Vendor=\([0-9A-Fa-f]\{4\}\).*/\L\1/p')"
                product="$(printf '%s\n' "$line" | sed -n 's/.*Product=\([0-9A-Fa-f]\{4\}\).*/\L\1/p')"
                if [ -n "$vendor" ] && [ -n "$product" ]; then
                    local family
                    family="$(awk -v id="$vendor:$product" 'BEGIN { IGNORECASE = 1 } $1 == id { print $2; exit }' "$db_file")"
                    if [ -n "$family" ]; then
                        printf '%s' "$family"
                        return
                    fi
                fi
                ;;
            esac
    done < /proc/bus/input/devices

    printf ''
    return 0
}

controller_layout_file() {
    local layout="$1"
    local candidate=""

    if [ -n "$layout" ] && [ -n "$anvil_root" ]; then
        candidate="$anvil_root/config/controller-layouts/$layout.json"
        if [ -f "$candidate" ]; then
            printf '%s' "$candidate"
            return
        fi
    fi

    printf ''
}

sdl_controller_db_file() {
    local candidate=""

    if [ -n "$sdl_controller_db" ] && [ -f "$sdl_controller_db" ]; then
        printf '%s' "$sdl_controller_db"
        return
    fi

    if [ -n "$anvil_root" ]; then
        candidate="$anvil_root/config/sdl-gamecontrollerdb.txt"
        if [ -f "$candidate" ]; then
            printf '%s' "$candidate"
            return
        fi
    fi

    printf ''
}

export_sdl_controller_mappings() {
    local map_file
    local db_file
    local mappings=""

    map_file="$(input_map_file "${ANVIL_INPUT_MAP:-}")"
    if [ -n "$map_file" ]; then
        mappings="$(sed -n 's/^sdl=//p' "$map_file")"
    fi

    db_file="$(sdl_controller_db_file)"
    if [ -n "$db_file" ]; then
        if [ -n "$mappings" ]; then
            local extra_mappings
            extra_mappings="$(grep -Ev '^[[:space:]]*(#|$)' "$db_file" || true)"
            if [ -n "$extra_mappings" ]; then
                mappings="$mappings
$extra_mappings"
            fi
        else
            mappings="$(grep -Ev '^[[:space:]]*(#|$)' "$db_file" || true)"
        fi
    fi

    if [ -z "$mappings" ]; then
        return
    fi

    printf '%s\n' "$mappings" > "$sdl_runtime_db_file"

    export SDL_GAMECONTROLLERCONFIG_FILE="$sdl_runtime_db_file"
    export SDL_GAMECONTROLLERCONFIG
    SDL_GAMECONTROLLERCONFIG="$(printf '%s\n' "$mappings")"
    export SDL_GAMEPADCONFIG_FILE="$sdl_runtime_db_file"
    export SDL_GAMEPADCONFIG="$SDL_GAMECONTROLLERCONFIG"
    export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1
}

start_overlay_watcher() {
    local watcher="$anvil_root/scripts/anvil-controller-overlay-watch"
    if [ ! -x "$watcher" ]; then
        return 0
    fi

    env -u ANVIL_GAME_SESSION_ID ANVIL_ROOT="$anvil_root" "$watcher" &
    printf '%s\n' "$!" > "$watcher_pid_file"
}

run_session() {
    local name=""
    local game_id=""
    local input_profile=""
    local input_map=""
    local controller_layout=""
    local achievement_set=""
    local achievements_url="${ANVIL_ACHIEVEMENTS_URL:-${FORGEWORKS_ACHIEVEMENTS_URL:-}}"

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --name)
                name="${2:-}"
                shift 2
                ;;
            --game-id)
                game_id="${2:-}"
                shift 2
                ;;
            --input-profile)
                input_profile="${2:-}"
                shift 2
                ;;
            --input-map)
                input_map="${2:-}"
                shift 2
                ;;
            --controller-layout)
                controller_layout="${2:-}"
                shift 2
                ;;
            --achievement-set)
                achievement_set="${2:-}"
                shift 2
                ;;
            --achievements-url)
                achievements_url="${2:-}"
                shift 2
                ;;
            --)
                shift
                break
                ;;
            *)
                usage
                ;;
        esac
    done

    [ "$#" -gt 0 ] || usage
    local launch_command="$*"
    local session_id
    session_id="$(date +%s)-$$"

    mkdir -p "$state_dir"
    stop_session
    write_meta "$name" "$game_id" "$session_id" "$input_profile" "$input_map" "$controller_layout" "$achievement_set" "$achievements_url"

    export ANVIL_GAME_NAME="$name"
    export ANVIL_GAME_ID="$game_id"
    export ANVIL_GAME_SESSION_ID="$session_id"
    export ANVIL_INPUT_PROFILE="$input_profile"
    export ANVIL_INPUT_MAP="$input_map"
    export ANVIL_INPUT_MAP_FILE
    ANVIL_INPUT_MAP_FILE="$(input_map_file "$input_map")"
    export ANVIL_CONTROLLER_FAMILY
    ANVIL_CONTROLLER_FAMILY="$(active_controller_family)"
    export ANVIL_CONTROLLER_LAYOUT="$controller_layout"
    export ANVIL_CONTROLLER_LAYOUT_FILE
    ANVIL_CONTROLLER_LAYOUT_FILE="$(controller_layout_file "$controller_layout")"
    export ANVIL_ACHIEVEMENT_SET="$achievement_set"
    export ANVIL_ACHIEVEMENT_SET_FILE
    ANVIL_ACHIEVEMENT_SET_FILE="$(achievement_set_file "$achievement_set")"
    export ANVIL_ACHIEVEMENTS_URL="$achievements_url"
    export ANVIL_SDL_CONTROLLER_DB
    ANVIL_SDL_CONTROLLER_DB="$(sdl_controller_db_file)"
    export_sdl_controller_mappings
    start_overlay_watcher

    setsid bash -lc "$launch_command" &
    local pid=$!
    printf '%s\n' "$pid" > "$pid_file"

    local status=0
    wait "$pid" || status=$?
    while [ -n "$(session_env_pids "$session_id")" ]; do
        sleep 0.5
    done
    stop_overlay_watcher
    rm -f "$pid_file" "$meta_file" "$sdl_runtime_db_file" "$watcher_pid_file"
    return "$status"
}

case "${1:-}" in
    run)
        shift
        run_session "$@"
        ;;
    stop)
        stop_session
        ;;
    *)
        usage
        ;;
esac
