#!/usr/bin/env bash
set -euo pipefail

runtime_root="${XDG_RUNTIME_DIR:-/tmp}/anvil"
state_dir="$runtime_root/game-session"
pid_file="$state_dir/pid"
meta_file="$state_dir/current.env"
sdl_runtime_db_file="$state_dir/sdl-gamecontrollerdb.txt"
watcher_pid_file="$state_dir/controller-overlay-watch.pid"
anvil_root="${ANVIL_ROOT:-}"
sdl_controller_db="${ANVIL_SDL_CONTROLLER_DB:-}"

usage() {
    echo "usage: anvil-game-session run [--name NAME] [--input-profile PROFILE] [--input-map MAP] [--controller-layout LAYOUT] -- COMMAND" >&2
    echo "       anvil-game-session stop" >&2
    exit 64
}

stop_session() {
    stop_overlay_watcher

    if [ ! -s "$pid_file" ]; then
        return 0
    fi

    local pid
    pid="$(cat "$pid_file" 2>/dev/null || true)"
    if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
        rm -f "$pid_file" "$meta_file" "$sdl_runtime_db_file" "$watcher_pid_file"
        return 0
    fi

    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true

    local waited=0
    while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt 30 ]; do
        sleep 0.1
        waited=$((waited + 1))
    done

    if kill -0 "$pid" 2>/dev/null; then
        kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
    fi

    rm -f "$pid_file" "$meta_file" "$sdl_runtime_db_file" "$watcher_pid_file"
}

stop_overlay_watcher() {
    if [ ! -s "$watcher_pid_file" ]; then
        return 0
    fi

    local watcher_pid
    watcher_pid="$(cat "$watcher_pid_file" 2>/dev/null || true)"
    if [ -n "$watcher_pid" ] && kill -0 "$watcher_pid" 2>/dev/null; then
        kill -TERM "$watcher_pid" 2>/dev/null || true
    fi
    rm -f "$watcher_pid_file"
}

write_meta() {
    local name="$1"
    local input_profile="$2"
    local input_map="$3"
    local controller_layout="$4"

    {
        printf 'ANVIL_GAME_NAME=%q\n' "$name"
        printf 'ANVIL_INPUT_PROFILE=%q\n' "$input_profile"
        printf 'ANVIL_INPUT_MAP=%q\n' "$input_map"
        printf 'ANVIL_INPUT_MAP_FILE=%q\n' "$(input_map_file "$input_map")"
        printf 'ANVIL_CONTROLLER_FAMILY=%q\n' "$(active_controller_family)"
        printf 'ANVIL_CONTROLLER_LAYOUT=%q\n' "$controller_layout"
        printf 'ANVIL_CONTROLLER_LAYOUT_FILE=%q\n' "$(controller_layout_file "$controller_layout")"
        printf 'ANVIL_SDL_CONTROLLER_DB=%q\n' "$(sdl_controller_db_file)"
        printf 'ANVIL_STARTED_AT=%q\n' "$(date -Iseconds)"
    } > "$meta_file"
}

input_map_file() {
    local map="$1"
    local candidate=""

    [ -n "$map" ] || return 0

    if [ -f "$map" ]; then
        printf '%s' "$map"
        return
    fi

    if [ -n "$anvil_root" ]; then
        candidate="$anvil_root/config/input-maps/$map"
        if [ -f "$candidate" ]; then
            printf '%s' "$candidate"
            return
        fi
    fi

    printf ''
}

active_controller_family() {
    local db_file=""
    local line=""
    local vendor=""
    local product=""

    if [ -n "$anvil_root" ]; then
        db_file="$anvil_root/config/controller-devices.db"
    fi
    [ -f "$db_file" ] || return 0

    while read -r line; do
        case "$line" in
            I:*)
                vendor="$(printf '%s\n' "$line" | sed -n 's/.*Vendor=\([0-9A-Fa-f]\{4\}\).*/\L\1/p')"
                product="$(printf '%s\n' "$line" | sed -n 's/.*Product=\([0-9A-Fa-f]\{4\}\).*/\L\1/p')"
                if [ -n "$vendor" ] && [ -n "$product" ]; then
                    local family
                    family="$(awk -v id="$vendor:$product" 'BEGIN { IGNORECASE = 1 } $1 == id { print $2; exit }' "$db_file")"
                    if [ -n "$family" ]; then
                        printf '%s' "$family"
                        return
                    fi
                fi
                ;;
            esac
    done < /proc/bus/input/devices

    printf ''
    return 0
}

controller_layout_file() {
    local layout="$1"
    local candidate=""

    if [ -n "$layout" ] && [ -n "$anvil_root" ]; then
        candidate="$anvil_root/config/controller-layouts/$layout.json"
        if [ -f "$candidate" ]; then
            printf '%s' "$candidate"
            return
        fi
    fi

    printf ''
}

sdl_controller_db_file() {
    local candidate=""

    if [ -n "$sdl_controller_db" ] && [ -f "$sdl_controller_db" ]; then
        printf '%s' "$sdl_controller_db"
        return
    fi

    if [ -n "$anvil_root" ]; then
        candidate="$anvil_root/config/sdl-gamecontrollerdb.txt"
        if [ -f "$candidate" ]; then
            printf '%s' "$candidate"
            return
        fi
    fi

    printf ''
}

export_sdl_controller_mappings() {
    local map_file
    local db_file
    local mappings=""

    map_file="$(input_map_file "${ANVIL_INPUT_MAP:-}")"
    if [ -n "$map_file" ]; then
        mappings="$(sed -n 's/^sdl=//p' "$map_file")"
    fi

    db_file="$(sdl_controller_db_file)"
    if [ -n "$db_file" ]; then
        if [ -n "$mappings" ]; then
            local extra_mappings
            extra_mappings="$(grep -Ev '^[[:space:]]*(#|$)' "$db_file" || true)"
            if [ -n "$extra_mappings" ]; then
                mappings="$mappings
$extra_mappings"
            fi
        else
            mappings="$(grep -Ev '^[[:space:]]*(#|$)' "$db_file" || true)"
        fi
    fi

    if [ -z "$mappings" ]; then
        return
    fi

    printf '%s\n' "$mappings" > "$sdl_runtime_db_file"

    export SDL_GAMECONTROLLERCONFIG_FILE="$sdl_runtime_db_file"
    export SDL_GAMECONTROLLERCONFIG
    SDL_GAMECONTROLLERCONFIG="$(printf '%s\n' "$mappings")"
    export SDL_GAMEPADCONFIG_FILE="$sdl_runtime_db_file"
    export SDL_GAMEPADCONFIG="$SDL_GAMECONTROLLERCONFIG"
    export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1
}

start_overlay_watcher() {
    local watcher="$anvil_root/scripts/anvil-controller-overlay-watch"
    if [ ! -x "$watcher" ]; then
        return 0
    fi

    ANVIL_ROOT="$anvil_root" "$watcher" &
    printf '%s\n' "$!" > "$watcher_pid_file"
}

run_session() {
    local name=""
    local input_profile=""
    local input_map=""
    local controller_layout=""

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --name)
                name="${2:-}"
                shift 2
                ;;
            --input-profile)
                input_profile="${2:-}"
                shift 2
                ;;
            --input-map)
                input_map="${2:-}"
                shift 2
                ;;
            --controller-layout)
                controller_layout="${2:-}"
                shift 2
                ;;
            --)
                shift
                break
                ;;
            *)
                usage
                ;;
        esac
    done

    [ "$#" -gt 0 ] || usage

    mkdir -p "$state_dir"
    stop_session
    write_meta "$name" "$input_profile" "$input_map" "$controller_layout"

    export ANVIL_GAME_NAME="$name"
    export ANVIL_INPUT_PROFILE="$input_profile"
    export ANVIL_INPUT_MAP="$input_map"
    export ANVIL_INPUT_MAP_FILE
    ANVIL_INPUT_MAP_FILE="$(input_map_file "$input_map")"
    export ANVIL_CONTROLLER_FAMILY
    ANVIL_CONTROLLER_FAMILY="$(active_controller_family)"
    export ANVIL_CONTROLLER_LAYOUT="$controller_layout"
    export ANVIL_CONTROLLER_LAYOUT_FILE
    ANVIL_CONTROLLER_LAYOUT_FILE="$(controller_layout_file "$controller_layout")"
    export ANVIL_SDL_CONTROLLER_DB
    ANVIL_SDL_CONTROLLER_DB="$(sdl_controller_db_file)"
    export_sdl_controller_mappings
    start_overlay_watcher

    setsid bash -lc "$*" &
    local pid=$!
    printf '%s\n' "$pid" > "$pid_file"

    local status=0
    wait "$pid" || status=$?
    stop_overlay_watcher
    rm -f "$pid_file" "$meta_file" "$sdl_runtime_db_file" "$watcher_pid_file"
    return "$status"
}

case "${1:-}" in
    run)
        shift
        run_session "$@"
        ;;
    stop)
        stop_session
        ;;
    *)
        usage
        ;;
esac
