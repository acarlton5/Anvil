#!/usr/bin/env bash
set -euo pipefail

section=""
fetch_art=0
install_session=0
logout_after_install=0
overlay_test=0

while [ "$#" -gt 0 ]; do
    case "$1" in
        --section)
            section="${2:-}"
            shift
            ;;
        --fetch-art)
            fetch_art=1
            ;;
        --overlay-test)
            overlay_test=1
            ;;
        --install-session)
            install_session=1
            ;;
        --logout)
            logout_after_install=1
            ;;
        *)
            echo "Unknown option: $1" >&2
            exit 64
            ;;
    esac
    shift
done

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
plugin_dir="$(dirname -- "$script_dir")"
repo_root="$(cd -- "$plugin_dir/../../.." && pwd)"

anvil_root="${ANVIL_ROOT:-}"
if [ -z "$anvil_root" ]; then
    for candidate in \
        "$repo_root" \
        "$HOME/Projects/Projects/Anvil" \
        "$HOME/DevBox/Projects/Anvil" \
        "$HOME/Projects/Anvil" \
        "/opt/anvil" \
        "/usr/local/share/anvil"; do
        if [ -f "$candidate/src/ui/AnvilDaemon.qml" ]; then
            anvil_root="$candidate"
            break
        fi
    done
fi

if [ -z "$anvil_root" ] || [ ! -f "$anvil_root/src/ui/AnvilDaemon.qml" ]; then
    echo "Anvil root not found. Set ANVIL_ROOT to a valid Anvil installation." >&2
    exit 1
fi

open_terminal_for_install() {
    local quoted_root
    quoted_root="$(printf '%q' "$anvil_root")"
    local quoted_self
    quoted_self="$(printf '%q' "$0")"
    local extra_args="--install-session"
    if [ "$logout_after_install" -eq 1 ]; then
        extra_args="$extra_args --logout"
    fi
    local command="ANVIL_INSTALL_IN_TERMINAL=1 ANVIL_ROOT=$quoted_root bash $quoted_self $extra_args; status=\\$?; if [ \\$status -eq 0 ]; then printf '\\nAnvil session action complete.\\n'; else printf '\\nAnvil session action failed with exit %s.\\n' \\$status; fi; printf 'Press Enter to close...'; read _"

    for terminal in "${TERMINAL:-}" ghostty kitty foot alacritty wezterm konsole xterm; do
        [ -n "$terminal" ] || continue
        if ! command -v "$terminal" >/dev/null 2>&1; then
            continue
        fi
        case "$(basename "$terminal")" in
            ghostty)
                exec "$terminal" --title="Anvil Session Setup" -e sh -lc "$command"
                ;;
            kitty)
                exec "$terminal" --detach=no -T "Anvil Session Setup" -e sh -lc "$command"
                ;;
            foot)
                exec "$terminal" --title="Anvil Session Setup" -e sh -lc "$command"
                ;;
            alacritty|wezterm)
                exec "$terminal" -T "Anvil Session Setup" -e sh -lc "$command"
                ;;
            konsole)
                exec "$terminal" --nofork -p tabtitle="Anvil Session Setup" -e sh -lc "$command"
                ;;
            xterm)
                exec "$terminal" -T "Anvil Session Setup" -e sh -lc "$command"
                ;;
        esac
    done

    echo "No terminal found for Anvil session setup." >&2
    exit 1
}

if [ "$install_session" -eq 1 ]; then
    if [ ! -t 0 ] && [ "${ANVIL_INSTALL_IN_TERMINAL:-0}" != "1" ]; then
        open_terminal_for_install
    fi
    "$plugin_dir/scripts/install-session" "$anvil_root"
    if [ "$logout_after_install" -eq 1 ]; then
        if [ -n "${XDG_SESSION_ID:-}" ] && command -v loginctl >/dev/null 2>&1; then
            exec loginctl terminate-session "$XDG_SESSION_ID"
        fi
        if command -v hype >/dev/null 2>&1; then
            exec hype ipc session logout
        fi
        echo "Anvil session installed. Log out and choose Anvil from the greeter." >&2
    fi
    exit 0
fi

if [ "$fetch_art" -eq 1 ]; then
    exec env ANVIL_ROOT="$anvil_root" python3 "$anvil_root/src/daemon/anvil_library.py" --fetch-art --scan
fi

if [ -n "$section" ]; then
    export ANVIL_SECTION="$section"
fi

if [ "$overlay_test" -eq 1 ]; then
    export ANVIL_OVERLAY_TEST=1
fi

exec env ANVIL_ROOT="$anvil_root" qs -p "$anvil_root/src/ui/AnvilDaemon.qml"
