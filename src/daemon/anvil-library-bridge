#!/usr/bin/env python3
"""
anvil-library-bridge — Thin wrapper invoked by the QML UI.

Mounts removable game drives, checks for Anvil updates, scans all cartridges,
and outputs one JSON status object to stdout. The QML Process component reads
stdout and parses the JSON.
"""
import sys
import os

# Add the daemon directory to the path
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from anvil_library import check_for_updates, discover_game_drives, scan_games
import json

def main():
    drives, mounted = discover_game_drives(auto_mount=True)
    games = scan_games(drives)
    print(json.dumps({
        "games": games,
        "drives": drives,
        "mounted": mounted,
        "update": check_for_updates(),
    }))

if __name__ == "__main__":
    main()
